+import static org.mockito.Mockito.when;
+
+/** B10 {@code NotificationService.deliver / send}: the row lifecycle, de-duplication and "never throws". */
+class NotificationServiceTest {
+
+    private NotificationRepository repository;
+    private NotificationSourceRepository sources;
+    private EmailSender sender;
+    private NotificationService service;
+
+    @BeforeEach
+    void setUp() {
+        repository = mock(NotificationRepository.class);
+        sources = mock(NotificationSourceRepository.class);
+        sender = mock(EmailSender.class);
+        service = new NotificationService(repository, sources, sender, new NotificationTemplateRenderer(),
+                mock(PlatformTransactionManager.class));
+        // a saved row gets an id, like the database would assign
+        when(repository.save(any(Notification.class))).thenAnswer(inv -> {
+            Notification n = inv.getArgument(0);
+            ReflectionTestUtils.setField(n, "id", 77L);
+            return n;
+        });
+        when(sender.send(any())).thenReturn(EmailSender.Delivery.SENT);
+        when(sources.findContact(9L)).thenReturn(Optional.of(contact(9L, "lan", "lan@example.test", true)));
+    }
+
+    static ContactRow contact(Long id, String username, String email, Boolean active) {
+        return new ContactRow() {
+            public Long getId() { return id; }
+            public String getUsername() { return username; }
+            public String getEmail() { return email; }
+            public Boolean getActive() { return active; }
+        };
+    }
+
+    private static Map<String, Object> orderContext() {
+        Map<String, Object> ctx = new LinkedHashMap<>();
+        ctx.put("orderId", 5L);
+        ctx.put("orderTotal", new BigDecimal("125000.00"));
+        return ctx;
+    }
+
+    private Notification savedRow() {
+        ArgumentCaptor<Notification> captor = ArgumentCaptor.forClass(Notification.class);
+        verify(repository).save(captor.capture());
+        return captor.getValue();
+    }
+
+    // ── happy path ───────────────────────────────────────────────────────────
+
+    @Test
+    void deliver_writesAPendingRow_sendsTheEmail_andMarksItSent() {
+        service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), "order:5:CREATED");
+
+        Notification row = savedRow();
+        assertEquals(9L, row.getUserId());
+        assertEquals(NotificationType.ORDER_CREATED, row.getType());
+        assertEquals(NotificationChannel.EMAIL, row.getChannel());
+        assertEquals(NotificationStatus.PENDING, row.getStatus(), "written as PENDING before the send");
+        assertEquals("order:5:CREATED", row.getDedupeKey());
+        assertEquals("EcoGreen: Đặt hàng thành công", row.getTitle());
+        assertTrue(row.getBody().contains("Xin chào lan,"));
+        assertTrue(row.getBody().contains("#5"));
+        assertTrue(row.getBody().contains("125.000 ₫"));
+
+        ArgumentCaptor<EmailMessage> mail = ArgumentCaptor.forClass(EmailMessage.class);
+        verify(sender).send(mail.capture());
+        assertEquals("lan@example.test", mail.getValue().to());
+        assertEquals("EcoGreen: Đặt hàng thành công", mail.getValue().subject());
+        assertTrue(mail.getValue().htmlBody().contains("<p"));
+        assertEquals(row.getBody(), mail.getValue().textBody(), "the plain-text part of the email is the stored body");
+
+        ArgumentCaptor<LocalDateTime> sentAt = ArgumentCaptor.forClass(LocalDateTime.class);
+        verify(repository).updateStatus(eq(77L), eq(NotificationStatus.SENT), sentAt.capture(), isNull());
+        assertNotNull(sentAt.getValue());
+    }
+
+    @Test
+    void send_isAsyncOnTheNotificationExecutor() throws Exception {
+        Async plain = NotificationService.class
+                .getMethod("send", Long.class, NotificationType.class, Map.class).getAnnotation(Async.class);
+        Async keyed = NotificationService.class
+                .getMethod("send", Long.class, NotificationType.class, Map.class, String.class).getAnnotation(Async.class);
+
+        assertNotNull(plain, "send must not run on the request thread");
+        assertNotNull(keyed, "send must not run on the request thread");
+        assertEquals(NotificationAsyncConfig.EXECUTOR, plain.value());
+        assertEquals(NotificationAsyncConfig.EXECUTOR, keyed.value());
+    }
+
+    // ── failures never reach the caller ──────────────────────────────────────
+
+    @Test
+    void send_whenSmtpFails_doesNotThrowAndMarksFailed() {
+        when(sender.send(any())).thenThrow(new EmailSendException("SMTP_MailSendException"));
+
+        assertDoesNotThrow(() -> service.send(9L, NotificationType.ORDER_CREATED, orderContext()));
+
+        verify(repository).updateStatus(77L, NotificationStatus.FAILED, null, NotificationService.REASON_SEND_ERROR);
+        verify(repository, never()).updateStatus(anyLong(), eq(NotificationStatus.SENT), any(), any());
+    }
+
+    @Test
+    void deliver_whenTheSenderThrowsAnythingUnchecked_marksFailed() {
+        when(sender.send(any())).thenThrow(new IllegalStateException("password=hunter2 to=lan@example.test"));
+
+        assertDoesNotThrow(() -> service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:5:PAID"));
+
+        verify(repository).updateStatus(77L, NotificationStatus.FAILED, null, NotificationService.REASON_SEND_ERROR);
+    }
+
+    @Test
+    void deliver_whenNoSmtpIsConfigured_marksFailedWithTheNotConfiguredCode() {
+        when(sender.send(any())).thenReturn(EmailSender.Delivery.NOT_CONFIGURED);
+
+        service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), "order:5:CREATED");
+
+        verify(repository).updateStatus(77L, NotificationStatus.FAILED, null, NotificationService.REASON_NOT_CONFIGURED);
+    }
+
+    @Test
+    void deliver_whenTheDatabaseFails_doesNotThrow() {
+        when(repository.save(any(Notification.class))).thenThrow(new IllegalStateException("db down"));
+
+        assertDoesNotThrow(() -> service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), "k"));
+        verify(sender, never()).send(any());
+    }
+
+    @Test
+    void deliver_whenTheStatusUpdateFails_doesNotThrow() {
+        when(repository.updateStatus(anyLong(), any(), any(), any())).thenThrow(new IllegalStateException("db down"));
+
+        assertDoesNotThrow(() -> service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), "k"));
+    }
+
+    @Test
+    void deliver_withMissingArguments_orUnknownUser_doesNothingAndDoesNotThrow() {
+        assertDoesNotThrow(() -> service.deliver(null, NotificationType.ORDER_CREATED, null, null));
+        assertDoesNotThrow(() -> service.deliver(9L, null, null, null));
+        assertDoesNotThrow(() -> service.deliver(404L, NotificationType.ORDER_CREATED, null, null));
+
+        verify(repository, never()).save(any(Notification.class));
+        verify(sender, never()).send(any());
+    }
+
+    // ── disabled user / no email ─────────────────────────────────────────────
+
+    @Test
+    void userDisabledOrNoEmail_marksFailedWithoutThrowing() {
+        when(sources.findContact(10L)).thenReturn(Optional.of(contact(10L, "off", "off@example.test", false)));
+        when(sources.findContact(11L)).thenReturn(Optional.of(contact(11L, "noemail", null, true)));
+        when(sources.findContact(12L)).thenReturn(Optional.of(contact(12L, "blank", "   ", true)));
+        when(sources.findContact(13L)).thenReturn(Optional.of(contact(13L, "bad", "not-an-address", true)));
+
+        assertDoesNotThrow(() -> service.deliver(10L, NotificationType.ORDER_CREATED, orderContext(), "a"));
+        assertDoesNotThrow(() -> service.deliver(11L, NotificationType.ORDER_CREATED, orderContext(), "b"));
+        assertDoesNotThrow(() -> service.deliver(12L, NotificationType.ORDER_CREATED, orderContext(), "c"));
+        assertDoesNotThrow(() -> service.deliver(13L, NotificationType.ORDER_CREATED, orderContext(), "d"));
+
+        ArgumentCaptor<Notification> rows = ArgumentCaptor.forClass(Notification.class);
+        verify(repository, times(4)).save(rows.capture());
+        assertEquals(NotificationService.REASON_USER_DISABLED, rows.getAllValues().get(0).getFailureReason());
+        assertEquals(NotificationService.REASON_NO_EMAIL, rows.getAllValues().get(1).getFailureReason());
+        assertEquals(NotificationService.REASON_NO_EMAIL, rows.getAllValues().get(2).getFailureReason());
+        assertEquals(NotificationService.REASON_NO_EMAIL, rows.getAllValues().get(3).getFailureReason(), "no @ is not an address");
+        for (Notification row : rows.getAllValues()) {
+            assertEquals(NotificationStatus.FAILED, row.getStatus());
+            assertNull(row.getSentAt());
+        }
+        verify(sender, never()).send(any());
+        verify(repository, never()).updateStatus(anyLong(), any(), any(), any());
+    }
+
+    // ── de-duplication ───────────────────────────────────────────────────────
+
+    @Test
+    void sameEventTwice_sendsOnce() {
+        Set<String> seen = new HashSet<>();
+        when(repository.existsByUserIdAndTypeAndDedupeKey(any(), any(), any()))
+                .thenAnswer(inv -> seen.contains(inv.getArgument(0) + "|" + inv.getArgument(1) + "|" + inv.getArgument(2)));
+        when(repository.save(any(Notification.class))).thenAnswer(inv -> {
+            Notification n = inv.getArgument(0);
+            seen.add(n.getUserId() + "|" + n.getType() + "|" + n.getDedupeKey());
+            ReflectionTestUtils.setField(n, "id", 77L);
+            return n;
+        });
+
+        service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:5:PAID");
+        service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:5:PAID");
+
+        verify(repository, times(1)).save(any(Notification.class));
+        verify(sender, times(1)).send(any());
+    }
+
+    @Test
+    void sameEventTwice_whenTheUniqueConstraintFires_sendsNothingTheSecondTime() {
+        when(repository.save(any(Notification.class))).thenThrow(new DataIntegrityViolationException("uq_notifications_dedupe"));
+
+        assertDoesNotThrow(() -> service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:5:PAID"));
+
+        verify(sender, never()).send(any());
+    }
+
+    @Test
+    void aDifferentKeyOrType_isNotADuplicate() {
+        when(repository.existsByUserIdAndTypeAndDedupeKey(9L, NotificationType.PAYMENT_SUCCESS, "order:5:PAID")).thenReturn(true);
+
+        service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:5:PAID");
+        verify(sender, never()).send(any());
+
+        service.deliver(9L, NotificationType.ORDER_SHIPPED, orderContext(), "order:5:SHIPPED");
+        service.deliver(9L, NotificationType.PAYMENT_SUCCESS, orderContext(), "order:6:PAID");
+        verify(sender, times(2)).send(any());
+    }
+
+    @Test
+    void withoutAKey_noDuplicateCheckIsMade() {
+        service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), null);
+
+        verify(repository, never()).existsByUserIdAndTypeAndDedupeKey(any(), any(), any());
+        assertNull(savedRow().getDedupeKey());
+    }
+
+    @Test
+    void aTooLongKey_isCutToTheColumnSize() {
+        service.deliver(9L, NotificationType.ORDER_CREATED, orderContext(), "k".repeat(300));
+
+        assertEquals(NotificationService.MAX_DEDUPE_KEY, savedRow().getDedupeKey().length());
+    }
+}
diff --git a/backend/src/test/java/com/example/backend/service/notification/NotificationTemplateRendererTest.java b/backend/src/test/java/com/example/backend/service/notification/NotificationTemplateRendererTest.java
new file mode 100644
index 0000000..b907940
--- /dev/null
+++ b/backend/src/test/java/com/example/backend/service/notification/NotificationTemplateRendererTest.java
@@ -0,0 +1,127 @@
+package com.example.backend.service.notification;
+
+import com.example.backend.entity.NotificationType;
+import com.example.backend.service.notification.NotificationTemplateRenderer.Rendered;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class NotificationTemplateRendererTest {
+
+    private final NotificationTemplateRenderer renderer = new NotificationTemplateRenderer();
+
+    private static Map<String, Object> ctx(Object... kv) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        for (int i = 0; i < kv.length; i += 2) {
+            m.put((String) kv[i], kv[i + 1]);
+        }
+        return m;
+    }
+
+    @Test
+    void templates_escapeHtmlInDynamicValues() {
+        Rendered r = renderer.render(NotificationType.RETURN_REJECTED, ctx(
+                "customerName", "<script>alert(1)</script>",
+                "returnId", 3L,
+                "note", "\"><img src=x onerror=alert(2)> & <b>bold</b>"));
+
+        assertFalse(r.html().contains("<script>"), "raw script tag must not survive");
+        assertFalse(r.html().contains("<img"), "raw img tag must not survive");
+        assertFalse(r.html().contains("<b>bold"), "raw b tag must not survive");
+        assertTrue(r.html().contains("&lt;script&gt;alert(1)&lt;/script&gt;"));
+        assertTrue(r.html().contains("&lt;img src=x onerror=alert(2)&gt; &amp; &lt;b&gt;bold&lt;/b&gt;"));
+        // the stored text body is plain text: no HTML structure of ours, the value is kept verbatim
+        assertTrue(r.text().contains("<script>alert(1)</script>"));
+        assertFalse(r.text().contains("<p"));
+    }
+
+    @Test
+    void templates_escapeEverywhereIncludingTheGreetingOfEveryType() {
+        for (NotificationType type : NotificationType.values()) {
+            Rendered r = renderer.render(type, ctx("customerName", "\"><svg/onload=1>", "orderId", 1L, "returnId", 2L,
+                    "note", "<i>n</i>", "orderTotal", new BigDecimal("1000")));
+            assertFalse(r.html().contains("<svg"), type + " leaked raw markup");
+            assertFalse(r.html().contains("<i>"), type + " leaked raw markup");
+        }
+    }
+
+    @Test
+    void everyType_hasAFixedVietnameseSubject_andABody() {
+        Set<String> titles = new HashSet<>();
+        for (NotificationType type : NotificationType.values()) {
+            Rendered r = renderer.render(type, ctx("customerName", "lan", "orderId", 5L, "returnId", 2L));
+            assertTrue(r.title().startsWith("EcoGreen: "), type.name());
+            assertEquals(r.title(), renderer.render(type, ctx("customerName", "other")).title(), "subject is fixed, never dynamic");
+            assertTrue(r.text().startsWith("Xin chào lan,"), type.name());
+            assertTrue(r.text().contains("EcoGreen"), type.name());
+            assertTrue(r.html().startsWith("<div"), type.name());
+            assertTrue(titles.add(r.title()), "each type has its own subject: " + r.title());
+        }
+    }
+
+    @Test
+    void ids_andAmounts_appearInTheRightTemplates() {
+        assertTrue(renderer.render(NotificationType.ORDER_CREATED, ctx("orderId", 5L, "orderTotal", new BigDecimal("125000.00"))).text()
+                .contains("Đơn hàng #5"));
+        assertTrue(renderer.render(NotificationType.PAYMENT_SUCCESS, ctx("orderId", 5L, "orderTotal", new BigDecimal("125000.00"))).text()
+                .contains("Tổng thanh toán: 125.000 ₫"));
+        assertTrue(renderer.render(NotificationType.RETURN_CREATED, ctx("returnId", 11L, "orderId", 5L)).text()
+                .contains("#11") );
+        assertTrue(renderer.render(NotificationType.ORDER_CANCELLED, ctx("orderId", 5L, "refundRequired", true)).text()
+                .contains("hoàn lại"));
+        assertFalse(renderer.render(NotificationType.ORDER_CANCELLED, ctx("orderId", 5L, "refundRequired", false)).text()
+                .contains("hoàn lại"));
+    }
+
+    @Test
+    void notes_appearOnlyWhenPresent_andAreCutAndCleaned() {
+        assertFalse(renderer.render(NotificationType.RETURN_REJECTED, ctx("returnId", 1L)).text().contains("Lý do"));
+        assertFalse(renderer.render(NotificationType.RETURN_REJECTED, ctx("returnId", 1L, "note", "   ")).text().contains("Lý do"));
+
+        String text = renderer.render(NotificationType.RETURN_INFO_REQUESTED, ctx("returnId", 1L, "note", "x".repeat(1000))).text();
+        assertTrue(text.contains("x".repeat(NotificationTemplateRenderer.MAX_NOTE)));
+        assertFalse(text.contains("x".repeat(NotificationTemplateRenderer.MAX_NOTE + 1)));
+
+        String cleaned = renderer.render(NotificationType.RETURN_REJECTED, ctx("returnId", 1L, "note", "a\r\nBcc: evil@x.test\tb")).text();
+        assertFalse(cleaned.contains("\r"));
+        assertTrue(cleaned.contains("Lý do: a  Bcc: evil@x.test b"));
+    }
+
+    @Test
+    void vnd_formatsWithDotsAndNoLocaleDependency() {
+        assertEquals("125.000 ₫", NotificationTemplateRenderer.vnd(new BigDecimal("125000.00")));
+        assertEquals("1.234.568 ₫", NotificationTemplateRenderer.vnd(new BigDecimal("1234567.50")));
+        assertEquals("0 ₫", NotificationTemplateRenderer.vnd(0));
+        assertEquals("999 ₫", NotificationTemplateRenderer.vnd(999L));
+        assertNull(NotificationTemplateRenderer.vnd(null));
+        assertNull(NotificationTemplateRenderer.vnd("125000"));
+    }
+
+    @Test
+    void missingOrOddContext_neverThrows() {
+        for (NotificationType type : NotificationType.values()) {
+            assertDoesNotThrow(() -> renderer.render(type, null), type.name());
+            assertDoesNotThrow(() -> renderer.render(type, Map.of()), type.name());
+            assertDoesNotThrow(() -> renderer.render(type, ctx("orderId", "not a number", "orderTotal", "abc", "customerName", 42)), type.name());
+        }
+        assertTrue(renderer.render(NotificationType.ORDER_CREATED, null).text().startsWith("Xin chào,"));
+    }
+
+    @Test
+    void aLongName_isCut() {
+        String text = renderer.render(NotificationType.ORDER_CREATED, ctx("customerName", "n".repeat(500), "orderId", 1L)).text();
+
+        assertTrue(text.contains("n".repeat(NotificationTemplateRenderer.MAX_NAME)));
+        assertFalse(text.contains("n".repeat(NotificationTemplateRenderer.MAX_NAME + 1)));
+    }
+}
diff --git a/docs/ai/contracts/B10-notification.md b/docs/ai/contracts/B10-notification.md
new file mode 100644
index 0000000..7d3dd29
--- /dev/null
+++ b/docs/ai/contracts/B10-notification.md
@@ -0,0 +1,129 @@
+# B10 — Notification contract
+
+Owner: B10 (Notification). Other modules append requests under "Requests for contract changes"; they do not edit this file or the code.
+Verified against the code of branch `feature/b10-notification` (based on `main` at `7d2ad88`, which already contains B09). Order of authority: the code > this contract.
+
+## 1. What B10 owns, and what it never does
+
+- Table `notifications` (migration `V90__notifications.sql`, hand-applied, idempotent; Flyway is not active), entity `Notification` and the enums `NotificationType`, `NotificationChannel`, `NotificationStatus`, repositories `NotificationRepository` and `NotificationSourceRepository`, the package `service/notification/*`: `NotificationService`, `NotificationEventListener`, `NotificationQueryService`, `NotificationTemplateRenderer`, `EmailSender` (`SmtpEmailSender`, `LoggingEmailSender`), `EmailMessage`, `EmailSendException`; the configs `config/NotificationAsyncConfig` and `config/NotificationMailConfig`; the DTOs `MyNotificationResponse` / `AdminNotificationResponse` and the controllers `NotificationV1Controller` / `AdminNotificationV1Controller`.
+- B10 only reads other modules' data, through projections in `NotificationSourceRepository` (it extends `Repository`, so it has no save/delete): the customer's `username`, `email` and `active` flag, the owner and total of an order, the owner and admin note of a return.
+- B10 never writes the tables of B02–B09, never changes an event class or any code of another module (no change to `OrderService.transitionStatus`, `RefundService`, `ReturnService`, `AnalyticsEvent*`, `Permissions`, auth).
+- A failure to notify never reaches the business flow (section 4).
+
+## 2. Entity — `entity/Notification` (table `notifications`)
+
+| Column | Type | Notes |
+|---|---|---|
+| `id` | `BIGSERIAL` PK | |
+| `user_id` | `BIGINT` NOT NULL | `fk_notifications_user` → `users`, `ON DELETE CASCADE`; a plain id in the entity |
+| `type` | `VARCHAR(50)` NOT NULL | a `NotificationType` name; `chk_notifications_type_format` checks only `^[A-Z][A-Z0-9_]*$` |
+| `channel` | `VARCHAR(20)` NOT NULL | `EMAIL`, `SMS`, `PUSH` (`chk_notifications_channel`). Only `EMAIL` is sent |
+| `title` | `VARCHAR(255)` NOT NULL | the fixed subject of the type |
+| `body` | `TEXT` NOT NULL | the PLAIN-TEXT message (shown in the app). The HTML email is rendered again from the same template and is not stored |
+| `status` | `VARCHAR(20)` NOT NULL DEFAULT `'PENDING'` | `PENDING`, `SENT`, `FAILED` (`chk_notifications_status`) |
+| `failure_reason` | `VARCHAR(50)` nullable | a short CODE when `FAILED`, never an exception message (section 5) |
+| `dedupe_key` | `VARCHAR(100)` nullable | e.g. `order:123:PAID`; unique with `(user_id, type)` (section 6) |
+| `sent_at` | `TIMESTAMP` nullable | set when `SENT`; local time of the JVM / database zone (D-9) |
+| `created_at` | `TIMESTAMP` NOT NULL | same zone |
+
+Indexes: `idx_notifications_user_created (user_id, created_at DESC)` for the customer list, `idx_notifications_status_created (status, created_at)` for the admin filter. The entity declares the same columns, indexes and unique constraint, so `ddl-auto=update` and `V90` give the same table; the foreign key and the three CHECKs exist only after `V90` (guarded by `pg_constraint`). `NotificationMigrationDriftTest` keeps SQL, entity and enums aligned.
+
+**Adjustments to the draft in `MODULE_SPECS.md` section 6 (with the reason):** `failure_reason` (the task needs a short reason on `FAILED` rows) and `dedupe_key` + `uq_notifications_dedupe` (the same event must never be sent twice) were added; `type` has a format CHECK instead of a closed list so a new type needs no DDL; listeners are `@TransactionalEventListener(AFTER_COMMIT)` instead of `@EventListener` (a rolled-back transaction must notify nobody; B09 convention).
+
+## 3. Public Java signatures
+
+```java
+// service/notification/NotificationService  (none of these throws)
+@Async("notificationExecutor")
+void send(Long userId, NotificationType type, Map<String, Object> templateContext);                 // the stable entry point
+@Async("notificationExecutor")
+void send(Long userId, NotificationType type, Map<String, Object> templateContext, String dedupeKey); // with de-duplication
+void deliver(Long userId, NotificationType type, Map<String, Object> templateContext, String dedupeKey); // the synchronous work
+
+// service/notification/NotificationQueryService
+Page<Notification> listMine(Long userId, Pageable pageable);          // only that user's rows
+Page<Notification> listAll(String status, Pageable pageable);         // BadRequestException for an unknown status
+static Pageable myPageable(Integer page, Integer size, String sort);
+static Pageable adminPageable(Integer page, Integer size, String sort);
+
+// service/notification/EmailSender
+Delivery send(EmailMessage message);   // enum Delivery { SENT, NOT_CONFIGURED }; throws EmailSendException
+```
+
+`send(...)` reads the customer by `userId` itself (the context only needs `orderId`, `orderTotal`, `returnId`, `refundRequired`, `note`; `customerName` is filled from the user). **Upgrade path (B13, message broker):** a consumer can call `send(userId, type, context)` or `deliver(...)` unchanged; the signature does not change, only who calls it.
+
+## 4. Safety rules (the part other modules rely on)
+
+- **Never fails the business flow.** Every listener runs `AFTER_COMMIT` with `fallbackExecution = false` (a rolled-back transaction notifies nobody; an event published outside any transaction is not notified) and is `@Async("notificationExecutor")`, so the lookups and the email never run on the request thread. `deliver` catches every `RuntimeException`; the log carries only the type, the user id and the exception class name, never the address, the content or an SMTP secret.
+- **Its own transactions.** Reads use a read-only `REQUIRES_NEW` transaction and projections (nothing is lazy-loaded outside a session); every write is a `REQUIRES_NEW` transaction. The `TransactionTemplate`s are created inside the try block, so a commit failure cannot escape (same pattern as B09).
+- **Executor.** `@EnableAsync` is switched on in ONE place, `NotificationAsyncConfig`. `notificationExecutor`: core 2, max 4, queue 200, thread prefix `notification-`, waits up to 10 s on shutdown. The rejection policy DISCARDS the task and logs one line; `CallerRunsPolicy` is deliberately not used (it would run the send on the request thread) and `AbortPolicy` is not used either (it would throw into the business flow). A dropped notification is not retried. Declaring an `Executor` bean makes Spring Boot skip its default `applicationTaskExecutor`; nothing in the repository uses that executor today (no other `@Async`, no MVC async), and `@Async` here always names `notificationExecutor`. A module that later needs `@Async` must name its own executor.
+- **SMTP timeouts.** `mail.smtp.connectiontimeout=5000`, `timeout=10000`, `writetimeout=10000` so a hung server cannot pin an executor thread.
+
+## 5. Notification types, templates and source events
+
+All templates are Vietnamese; the subject is fixed per type; every dynamic value is HTML-escaped in the email and verbatim in the stored plain-text body; money is `125.000 ₫`. Only an order id, a return id, an order total, a refund flag and a staff note are used: no address, phone, token or payment data. Mapping convention = B09's `AnalyticsEventListener`.
+
+| `NotificationType` | Subject | Source event (owner) | Condition | Dedupe key | Read by the listener |
+|---|---|---|---|---|---|
+| `ORDER_CREATED` | EcoGreen: Đặt hàng thành công | `OrderPlacedEvent(orderId, userId, total)` (B04) | always | `order:{id}:CREATED` | nothing (the event has `userId` and `total`) |
+| `PAYMENT_SUCCESS` | EcoGreen: Thanh toán thành công | `OrderStatusChangedEvent` (B05) | `newStatus == PAID` | `order:{id}:PAID` | order owner + total |
+| `ORDER_SHIPPED` | EcoGreen: Đơn hàng đang được giao | `OrderStatusChangedEvent` (B05) | `newStatus == SHIPPED` | `order:{id}:SHIPPED` | order owner + total |
+| `ORDER_DELIVERED` | EcoGreen: Đơn hàng đã được giao | `OrderStatusChangedEvent` (B05) | `newStatus == DELIVERED` and `oldStatus != RETURN_REQUESTED` (that move means a return was rejected, not a new delivery) | `order:{id}:DELIVERED` | order owner + total |
+| `ORDER_CANCELLED` | EcoGreen: Đơn hàng đã bị hủy | `OrderCancelledEvent(orderId, refundRequired)` (B05) | always | `order:{id}:CANCELLED` | order owner + total |
+| `RETURN_CREATED` | EcoGreen: Đã ghi nhận yêu cầu đổi trả | `ReturnCreatedEvent(returnId, orderId, userId)` (B07) | always | `return:{id}:CREATED` | nothing |
+| `RETURN_APPROVED` | EcoGreen: Yêu cầu đổi trả được chấp nhận | `ReturnStatusChangedEvent` (B07) | `newStatus == APPROVED` | `return:{id}:APPROVED` | return owner + order id + admin note |
+| `RETURN_REJECTED` | EcoGreen: Yêu cầu đổi trả bị từ chối | `ReturnStatusChangedEvent` (B07) | `newStatus == REJECTED` (the admin note is included as the reason) | `return:{id}:REJECTED` | same |
+| `RETURN_INFO_REQUESTED` | EcoGreen: Cần bổ sung thông tin đổi trả | `ReturnStatusChangedEvent` (B07) | `newStatus == INFO_REQUESTED` (the admin note is included) | `return:{id}:INFO_REQUESTED` | same |
+| `RETURN_REFUNDED` | EcoGreen: Đã ghi nhận hoàn tiền đổi trả | `ReturnStatusChangedEvent` (B07) | `newStatus == REFUNDED` | `return:{id}:REFUNDED` | same |
+
+Nothing is sent for any other order status (`PROCESSING`, `PACKED`, `RETURN_REQUESTED`, `RETURNED`, `REFUNDED`, `CANCELLED` via status change: the cancel email comes from `OrderCancelledEvent`) nor for the return statuses `PENDING` and `RETURNED`. The `RETURN_REFUNDED` wording says the refund is "recorded and being processed" on purpose: in B07 the status `REFUNDED` means a `PENDING` refund row was created, not that money has moved. There is no `PaymentSuccessEvent` (B06 is not changed): `PAYMENT_SUCCESS` is derived from `OrderStatusChangedEvent(newStatus = PAID)`; a COD order that goes `PENDING_PAYMENT → PROCESSING` gets no payment email.
+
+**Failure codes (`failure_reason`), the only values ever stored:** `USER_DISABLED` (the account is inactive), `NO_EMAIL` (empty address, or one without `@`), `SEND_ERROR` (the mail server refused or failed), `EMAIL_NOT_CONFIGURED` (no `SMTP_HOST`). A notification for a user that does not exist writes no row (the foreign key would reject it) and is only logged.
+
+## 6. De-duplication
+
+`(user_id, type, dedupe_key)` is unique (`uq_notifications_dedupe`). `deliver` first checks `existsByUserIdAndTypeAndDedupeKey` (cheap, skips the work) and then relies on the constraint for races: a `DataIntegrityViolationException` on insert means "already handled" and nothing is sent. A `FAILED` row also counts, so a failed notification is not re-sent automatically (no retry). A `null` key (direct `send(userId, type, ctx)`) is never a duplicate, because PostgreSQL treats NULLs as distinct in a unique constraint.
+
+## 7. Email transport and configuration
+
+- `spring-boot-starter-mail` (version from the Boot BOM) provides `JavaMailSender`. `NotificationMailConfig.emailSender` returns `SmtpEmailSender` only when `spring.mail.host` has text AND a `JavaMailSender` exists, otherwise `LoggingEmailSender`. (`@ConditionalOnProperty` alone is not enough: an empty host counts as "present".)
+- `SmtpEmailSender` sends the plain-text and the HTML version as one `multipart/alternative` UTF-8 message. **From address:** `SMTP_FROM`, else `SMTP_USERNAME` when it contains `@`, else the send fails with `EmailSendException("SMTP_NO_FROM_ADDRESS")` and the row is `FAILED` / `SEND_ERROR` (no invented address is ever used). `EmailSendException` carries a short code only and no cause, so no address or server detail reaches a log; `EmailMessage.toString()` prints only the user id and the type.
+- `LoggingEmailSender` (development, tests, any environment without `SMTP_HOST`) delivers nothing and logs ONLY `type` and `userId`. **Status chosen for log-only mode: `FAILED` with `failure_reason = EMAIL_NOT_CONFIGURED`**, because nothing was delivered; `SENT` is reserved for a message the SMTP server accepted. This respects the `PENDING/SENT/FAILED` CHECK. The notification stays visible in the customer's list either way.
+- Environment variables (all optional, none has a secret default; see `.env.example`): `SMTP_HOST`, `SMTP_PORT` (default 587), `SMTP_USERNAME`, `SMTP_PASSWORD`, `SMTP_FROM` (no default, see the From rule above), `SMTP_AUTH` (default true), `SMTP_STARTTLS` (default true). They map to `spring.mail.*` and `ecogreen.notification.mail-from` in `application.properties` (additive).
+
+## 8. Endpoints (`/api/v1`; envelope `{data, meta}`; errors `{error:{code,message}}`; size default 20, max 100)
+
+| Method | Path | Auth | Request | Response | Errors |
+|---|---|---|---|---|---|
+| GET | `/api/v1/users/me/notifications` | logged-in user | `page?`, `size?`, `sort?` (`createdAt`, `id`; default `createdAt,desc`) | paged `[{id, type, channel, title, body, status, sentAt, createdAt}]`, only the caller's rows | 400 (bad sort), 401 |
+| GET | `/api/v1/admin/notifications` | `analytics:view` | `status?` (`PENDING`/`SENT`/`FAILED`, case-insensitive), `page?`, `size?`, `sort?` (`createdAt`, `id`, `status`, `type`) | paged `[{id, userId, type, channel, title, status, failureReason, sentAt, createdAt}]` | 400 `VALIDATION_ERROR` (unknown status, bad sort), 401, 403 |
+
+- The customer list takes the user id ONLY from the verified token; there is no user parameter and a `userId` in the query string is ignored. It never returns `failureReason` or `dedupeKey`.
+- The admin list returns no body and no email address (so `analytics:view` does not expose customer content) and only the short failure code.
+- Both lists are paged, use the two indexes above, and never call `findAll()` without a `Pageable`. Times are UTC instants (`ReportTime` from B09 is reused for the conversion; D-9 rule as in the B09 contract section 7).
+
+## 9. TEMPORARY-COMPAT and known limitations
+
+- **TEMPORARY-COMPAT: none** was created.
+- **Only the EMAIL channel exists.** `User` has no phone, so SMS and PUSH are valid in the CHECK constraint but nothing sends them; no phone column was added.
+- **No retry.** A `FAILED` row stays `FAILED`; a dropped task (executor saturated) is only logged. No scheduled re-send, no outbox.
+- **No preferences or unsubscribe.** Every customer gets every notification of section 5; there is no opt-out and no per-type setting.
+- **Best effort.** A notification is lost if the process dies between the commit and the listener, or while queued. If the final status update fails, the row stays `PENDING`.
+- **`PENDING` rows** are possible only in that failure case (and briefly while sending); nothing sweeps them.
+- The username is used as the greeting name (the user has no separate display name). The admin note of a return is included in the reject / info-request email: B07 already shows that note to the customer.
+- The SQL of the unique constraint, the status update and the unique-violation path is exercised only by `NotificationPostgresTest`, which needs `ECOGREEN_TEST_PG_URL` and is skipped otherwise. A real SMTP delivery is not covered by any automatic test.
+- `@Async` on a `@TransactionalEventListener` method (used so the lookups leave the request thread) is a supported Spring combination, but it has not been run against this application context by an automated test here.
+

@@ -0,0 +1,64 @@
+package com.example.backend.service.notification;
+
+import com.example.backend.api.ApiPaging;
+import com.example.backend.entity.Notification;
+import com.example.backend.entity.NotificationStatus;
+import com.example.backend.exception.BadRequestException;
+import com.example.backend.repository.NotificationRepository;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.data.domain.Sort;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.Map;
+
+/** Read side of B10: a customer's own notifications and the admin delivery log. Always paged, never {@code findAll()}. */
+@Service
+public class NotificationQueryService {
+
+    private static final Map<String, String> MY_SORT = Map.of("createdAt", "createdAt", "id", "id");
+    private static final Map<String, String> ADMIN_SORT = Map.of("createdAt", "createdAt", "id", "id", "status", "status", "type", "type");
+    private static final Sort DEFAULT_SORT = Sort.by(Sort.Direction.DESC, "createdAt").and(Sort.by(Sort.Direction.DESC, "id"));
+
+    private final NotificationRepository repository;
+
+    public NotificationQueryService(NotificationRepository repository) {
+        this.repository = repository;
+    }
+
+    /** Size default 20, max 100; {@code sort} whitelisted (createdAt, id); default newest first. */
+    public static Pageable myPageable(Integer page, Integer size, String sort) {
+        return ApiPaging.of(page, size, sort, MY_SORT, DEFAULT_SORT);
+    }
+
+    /** Same limits; {@code sort} whitelisted (createdAt, id, status, type). */
+    public static Pageable adminPageable(Integer page, Integer size, String sort) {
+        return ApiPaging.of(page, size, sort, ADMIN_SORT, DEFAULT_SORT);
+    }
+
+    /** Only rows of {@code userId}; the caller passes the id from the verified token, never from the request. */
+    @Transactional(readOnly = true)
+    public Page<Notification> listMine(Long userId, Pageable pageable) {
+        return repository.findByUserId(userId, pageable);
+    }
+
+    /**
+     * Delivery log, optionally one status. A blank {@code status} means all.
+     *
+     * @throws BadRequestException (VALIDATION_ERROR) for a value that is not a {@link NotificationStatus}
+     */
+    @Transactional(readOnly = true)
+    public Page<Notification> listAll(String status, Pageable pageable) {
+        if (status == null || status.isBlank()) {
+            return repository.findAll(pageable);
+        }
+        NotificationStatus wanted;
+        try {
+            wanted = NotificationStatus.valueOf(status.trim().toUpperCase(java.util.Locale.ROOT));
+        } catch (IllegalArgumentException e) {
+            throw new BadRequestException("Trạng thái thông báo không hợp lệ.");
+        }
+        return repository.findByStatus(wanted, pageable);
+    }
+}
diff --git a/backend/src/main/java/com/example/backend/service/notification/NotificationService.java b/backend/src/main/java/com/example/backend/service/notification/NotificationService.java
new file mode 100644
index 0000000..b7cff92
--- /dev/null
+++ b/backend/src/main/java/com/example/backend/service/notification/NotificationService.java
@@ -0,0 +1,153 @@
+package com.example.backend.service.notification;
+
+import com.example.backend.config.NotificationAsyncConfig;
+import com.example.backend.entity.Notification;
+import com.example.backend.entity.NotificationChannel;
+import com.example.backend.entity.NotificationStatus;
+import com.example.backend.entity.NotificationType;
+import com.example.backend.repository.NotificationRepository;
+import com.example.backend.repository.NotificationSourceRepository;
+import com.example.backend.repository.NotificationSourceRepository.ContactRow;
+import com.example.backend.service.notification.NotificationTemplateRenderer.Rendered;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.scheduling.annotation.Async;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.TransactionDefinition;
+import org.springframework.transaction.support.TransactionTemplate;
+
+import java.time.LocalDateTime;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Writes a {@code notifications} row and sends the email (B10). Nothing in here may slow down or fail the business flow:
+ *
+ * <ul>
+ *   <li>{@link #send} runs on {@code notificationExecutor} (see {@link NotificationAsyncConfig}), never on the request thread;</li>
+ *   <li>{@link #deliver} catches every {@link RuntimeException}; the log carries only the type, the user id and the exception
+ *       class, never the address, the content or an SMTP secret;</li>
+ *   <li>every write is its own transaction ({@code REQUIRES_NEW}), created inside the try block, so no failure reaches a caller.</li>
+ * </ul>
+ *
+ * The signature of {@link #send(Long, NotificationType, Map)} is stable: when B13 brings a message broker, a consumer can call it
+ * (or {@link #deliver}) without any change here.
+ */
+@Service
+public class NotificationService {
+
+    private static final Logger log = LoggerFactory.getLogger(NotificationService.class);
+
+    static final String REASON_USER_DISABLED = "USER_DISABLED";
+    static final String REASON_NO_EMAIL = "NO_EMAIL";
+    static final String REASON_SEND_ERROR = "SEND_ERROR";
+    static final String REASON_NOT_CONFIGURED = "EMAIL_NOT_CONFIGURED";
+    static final int MAX_DEDUPE_KEY = 100;
+
+    private final NotificationRepository repository;
+    private final NotificationSourceRepository sources;
+    private final EmailSender emailSender;
+    private final NotificationTemplateRenderer renderer;
+    private final TransactionTemplate requiresNew;
+    private final TransactionTemplate readOnlyNew;
+
+    public NotificationService(NotificationRepository repository, NotificationSourceRepository sources,
+                               EmailSender emailSender, NotificationTemplateRenderer renderer,
+                               PlatformTransactionManager transactionManager) {
+        this.repository = repository;
+        this.sources = sources;
+        this.emailSender = emailSender;
+        this.renderer = renderer;
+        TransactionTemplate write = new TransactionTemplate(transactionManager);
+        write.setPropagationBehavior(TransactionDefinition.PROPAGATION_REQUIRES_NEW);
+        this.requiresNew = write;
+        TransactionTemplate read = new TransactionTemplate(transactionManager);
+        read.setPropagationBehavior(TransactionDefinition.PROPAGATION_REQUIRES_NEW);
+        read.setReadOnly(true);
+        this.readOnlyNew = read;
+    }
+
+    /** Sends {@code type} to {@code userId} in the background. No de-duplication (use the overload with a key for events). */
+    @Async(NotificationAsyncConfig.EXECUTOR)
+    public void send(Long userId, NotificationType type, Map<String, Object> templateContext) {
+        deliver(userId, type, templateContext, null);
+    }
+
+    /** Same, but a second call with the same {@code (userId, type, dedupeKey)} sends nothing. */
+    @Async(NotificationAsyncConfig.EXECUTOR)
+    public void send(Long userId, NotificationType type, Map<String, Object> templateContext, String dedupeKey) {
+        deliver(userId, type, templateContext, dedupeKey);
+    }
+
+    /**
+     * The synchronous work behind {@link #send}: de-duplicate, read the customer, write the row, send, record the outcome.
+     * Never throws. The event listener (already on the notification executor) calls this directly to avoid a second hop.
+     */
+    public void deliver(Long userId, NotificationType type, Map<String, Object> templateContext, String dedupeKey) {
+        try {
+            if (userId == null || type == null) {
+                log.warn("Notification skipped: missing user or type");
+                return;
+            }
+            String key = dedupeKey != null && dedupeKey.length() > MAX_DEDUPE_KEY ? dedupeKey.substring(0, MAX_DEDUPE_KEY) : dedupeKey;
+            if (key != null && repository.existsByUserIdAndTypeAndDedupeKey(userId, type, key)) {
+                log.info("Notification {} for user {} skipped: already handled", type, userId);
+                return;
+            }
+            ContactRow contact = readOnlyNew.execute(status -> sources.findContact(userId).orElse(null));
+            if (contact == null) {
+                log.warn("Notification {} skipped: user {} not found", type, userId);
+                return;
+            }
+            Map<String, Object> context = new LinkedHashMap<>();
+            if (templateContext != null) {
+                context.putAll(templateContext);
+            }
+            context.put("customerName", contact.getUsername());
+            Rendered rendered = renderer.render(type, context);
+
+            String blocked = null;
+            if (!Boolean.TRUE.equals(contact.getActive())) {
+                blocked = REASON_USER_DISABLED;
+            } else if (contact.getEmail() == null || contact.getEmail().isBlank() || !contact.getEmail().contains("@")) {
+                blocked = REASON_NO_EMAIL;
+            }
+            Notification row = new Notification(userId, type, NotificationChannel.EMAIL, rendered.title(), rendered.text(),
+                    blocked == null ? NotificationStatus.PENDING : NotificationStatus.FAILED, blocked, key);
+            Notification saved;
+            try {
+                saved = requiresNew.execute(status -> repository.save(row));
+            } catch (DataIntegrityViolationException duplicate) {
+                log.info("Notification {} for user {} skipped: already handled", type, userId);
+                return;
+            }
+            if (blocked != null || saved == null || saved.getId() == null) {
+                return;
+            }
+
+            Outcome outcome = attempt(new EmailMessage(type, userId, contact.getEmail().trim(), rendered.title(), rendered.text(),
+                    rendered.html()));
+            requiresNew.executeWithoutResult(status ->
+                    repository.updateStatus(saved.getId(), outcome.status(), outcome.sentAt(), outcome.reason()));
+        } catch (RuntimeException e) {
+            log.warn("Notification {} for user {} failed: {}", type, userId, e.getClass().getSimpleName());
+        }
+    }
+
+    private record Outcome(NotificationStatus status, LocalDateTime sentAt, String reason) {
+    }
+
+    private Outcome attempt(EmailMessage message) {
+        try {
+            if (emailSender.send(message) == EmailSender.Delivery.SENT) {
+                return new Outcome(NotificationStatus.SENT, LocalDateTime.now(), null);
+            }
+            return new Outcome(NotificationStatus.FAILED, null, REASON_NOT_CONFIGURED);
+        } catch (RuntimeException e) {
+            log.warn("Email for notification {} (user {}) failed: {}", message.type(), message.userId(), e.getClass().getSimpleName());
+            return new Outcome(NotificationStatus.FAILED, null, REASON_SEND_ERROR);
+        }
+    }
+}
diff --git a/backend/src/main/java/com/example/backend/service/notification/NotificationTemplateRenderer.java b/backend/src/main/java/com/example/backend/service/notification/NotificationTemplateRenderer.java
new file mode 100644
index 0000000..89926f9
--- /dev/null
+++ b/backend/src/main/java/com/example/backend/service/notification/NotificationTemplateRenderer.java
@@ -0,0 +1,175 @@
+package com.example.backend.service.notification;
+
+import com.example.backend.entity.NotificationType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.util.HtmlUtils;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.text.DecimalFormat;
+import java.text.DecimalFormatSymbols;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Vietnamese templates for every {@link NotificationType} (B10). The subject is fixed per type. Every DYNAMIC value (name,
+ * ids, amounts, notes) goes through {@link Dyn}: it is HTML-escaped in the email and left as plain text in the stored body, so
+ * a customer name like {@code <script>} can never become markup. Only an order id, a return id, an order total, a refund flag
+ * and a staff note are ever used: no address, phone, token or payment data.
+ *
+ * <p>Context keys: {@code customerName}, {@code orderId}, {@code orderTotal}, {@code returnId}, {@code refundRequired},
+ * {@code note}. A missing key renders as a neutral placeholder; it never throws.
+ */
+@Component
+public class NotificationTemplateRenderer {
+
+    static final int MAX_NAME = 100;
+    static final int MAX_NOTE = 300;
+
+    /** Subject and plain-text body (stored, shown in the app) and HTML body (sent by email). */
+    public record Rendered(String title, String text, String html) {
+    }
+
+    /** A dynamic value inside a paragraph: escaped for HTML, verbatim for text. */
+    record Dyn(String value) {
+    }
+
+    public Rendered render(NotificationType type, Map<String, Object> ctx) {
+        Map<String, Object> c = ctx == null ? Map.of() : ctx;
+        String title = title(type);
+        List<List<Object>> paragraphs = new ArrayList<>();
+        paragraphs.add(greeting(c));
+        paragraphs.addAll(content(type, c));
+        paragraphs.add(List.of("Trân trọng,"));
+        paragraphs.add(List.of("EcoGreen"));
+        paragraphs.add(List.of("Email này được gửi tự động, vui lòng không trả lời."));
+
+        StringBuilder text = new StringBuilder();
+        StringBuilder html = new StringBuilder("<div style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#222\">");
+        html.append("<h2 style=\"font-size:18px;margin:0 0 12px\">").append(HtmlUtils.htmlEscape(title)).append("</h2>");
+        for (List<Object> paragraph : paragraphs) {
+            StringBuilder rawLine = new StringBuilder();
+            StringBuilder htmlLine = new StringBuilder();
+            for (Object part : paragraph) {
+                if (part instanceof Dyn d) {
+                    rawLine.append(d.value());
+                    htmlLine.append(HtmlUtils.htmlEscape(d.value()));
+                } else {
+                    rawLine.append(part);
+                    htmlLine.append(HtmlUtils.htmlEscape(String.valueOf(part)));
+                }
+            }
+            if (!text.isEmpty()) {
+                text.append("\n\n");
+            }
+            text.append(rawLine);
+            html.append("<p style=\"margin:0 0 10px\">").append(htmlLine).append("</p>");
+        }
+        html.append("</div>");
+        return new Rendered(title, text.toString(), html.toString());
+    }
+
+    /** Fixed subject per type. */
+    public String title(NotificationType type) {
+        return switch (type) {
+            case ORDER_CREATED -> "EcoGreen: Đặt hàng thành công";
+            case PAYMENT_SUCCESS -> "EcoGreen: Thanh toán thành công";
+            case ORDER_SHIPPED -> "EcoGreen: Đơn hàng đang được giao";
+            case ORDER_DELIVERED -> "EcoGreen: Đơn hàng đã được giao";
+            case ORDER_CANCELLED -> "EcoGreen: Đơn hàng đã bị hủy";
+            case RETURN_CREATED -> "EcoGreen: Đã ghi nhận yêu cầu đổi trả";
+            case RETURN_APPROVED -> "EcoGreen: Yêu cầu đổi trả được chấp nhận";
+            case RETURN_REJECTED -> "EcoGreen: Yêu cầu đổi trả bị từ chối";
+            case RETURN_INFO_REQUESTED -> "EcoGreen: Cần bổ sung thông tin đổi trả";
+            case RETURN_REFUNDED -> "EcoGreen: Đã ghi nhận hoàn tiền đổi trả";
+        };
+    }
+
+    private List<Object> greeting(Map<String, Object> c) {
+        String name = clean(c.get("customerName"), MAX_NAME);
+        return name.isEmpty() ? List.of("Xin chào,") : List.of("Xin chào ", new Dyn(name), ",");
+    }
+
+    private List<List<Object>> content(NotificationType type, Map<String, Object> c) {
+        Dyn order = new Dyn(id(c.get("orderId")));
+        Dyn ret = new Dyn(id(c.get("returnId")));
+        List<List<Object>> out = new ArrayList<>();
+        switch (type) {
+            case ORDER_CREATED -> {
+                out.add(List.of("Cảm ơn bạn đã đặt hàng. Đơn hàng #", order, " đã được ghi nhận."));
+                addTotal(out, c);
+                out.add(List.of("Chúng tôi sẽ thông báo cho bạn khi đơn hàng có cập nhật mới."));
+            }
+            case PAYMENT_SUCCESS -> {
+                out.add(List.of("Chúng tôi đã nhận được thanh toán cho đơn hàng #", order, "."));
+                addTotal(out, c);
+                out.add(List.of("Đơn hàng của bạn sẽ được xử lý trong thời gian sớm nhất."));
+            }
+            case ORDER_SHIPPED -> out.add(List.of("Đơn hàng #", order, " đã được bàn giao cho đơn vị vận chuyển và đang trên đường đến bạn."));
+            case ORDER_DELIVERED -> out.add(List.of("Đơn hàng #", order, " đã được giao thành công. Cảm ơn bạn đã mua sắm tại EcoGreen."));
+            case ORDER_CANCELLED -> {
+                out.add(List.of("Đơn hàng #", order, " đã bị hủy."));
+                if (Boolean.TRUE.equals(c.get("refundRequired"))) {
+                    out.add(List.of("Khoản thanh toán của bạn sẽ được hoàn lại theo quy trình hoàn tiền."));
+                }
+            }
+            case RETURN_CREATED -> out.add(List.of("Chúng tôi đã ghi nhận yêu cầu đổi trả #", ret, " cho đơn hàng #", order, ". Chúng tôi sẽ xem xét và phản hồi sớm."));
+            case RETURN_APPROVED -> out.add(List.of("Yêu cầu đổi trả #", ret, " của bạn đã được chấp nhận. Vui lòng gửi hàng về theo hướng dẫn."));
+            case RETURN_REJECTED -> {
+                out.add(List.of("Rất tiếc, yêu cầu đổi trả #", ret, " của bạn đã bị từ chối."));
+                addNote(out, c, "Lý do: ");
+            }
+            case RETURN_INFO_REQUESTED -> {
+                out.add(List.of("Chúng tôi cần thêm thông tin để xử lý yêu cầu đổi trả #", ret, "."));
+                addNote(out, c, "Nội dung cần bổ sung: ");
+            }
+            case RETURN_REFUNDED -> out.add(List.of("Yêu cầu hoàn tiền cho đổi trả #", ret, " đã được ghi nhận và đang được xử lý."));
+        }
+        return out;
+    }
+
+    private void addTotal(List<List<Object>> out, Map<String, Object> c) {
+        String money = vnd(c.get("orderTotal"));
+        if (money != null) {
+            out.add(List.of("Tổng thanh toán: ", new Dyn(money)));
+        }
+    }
+
+    private void addNote(List<List<Object>> out, Map<String, Object> c, String label) {
+        String note = clean(c.get("note"), MAX_NOTE);
+        if (!note.isEmpty()) {
+            out.add(List.of(label, new Dyn(note)));
+        }
+    }
+
+    /** {@code 125000} becomes {@code 125.000 ₫}: fixed grouping, no rounding surprises, independent of the JVM locale. */
+    static String vnd(Object amount) {
+        BigDecimal value;
+        if (amount instanceof BigDecimal b) {
+            value = b;
+        } else if (amount instanceof Number n) {
+            value = new BigDecimal(n.toString());
+        } else {
+            return null;
+        }
+        DecimalFormatSymbols symbols = DecimalFormatSymbols.getInstance(Locale.ROOT);
+        symbols.setGroupingSeparator('.');
+        DecimalFormat format = new DecimalFormat("#,##0", symbols);
+        return format.format(value.setScale(0, RoundingMode.HALF_UP)) + " ₫";
+    }
+
+    private static String id(Object value) {
+        return value instanceof Number n ? String.valueOf(n.longValue()) : "?";
+    }
+
+    /** Text without control characters (so no line break can be smuggled in), trimmed and cut to {@code max}. */
+    static String clean(Object value, int max) {
+        if (value == null) {
+            return "";
+        }
+        String s = String.valueOf(value).replaceAll("\\p{Cntrl}", " ").trim();
+        return s.length() <= max ? s : s.substring(0, max);
+    }
+}
diff --git a/backend/src/main/java/com/example/backend/service/notification/SmtpEmailSender.java b/backend/src/main/java/com/example/backend/service/notification/SmtpEmailSender.java
new file mode 100644
index 0000000..c9bbbb6
--- /dev/null
+++ b/backend/src/main/java/com/example/backend/service/notification/SmtpEmailSender.java
@@ -0,0 +1,57 @@
+package com.example.backend.service.notification;
+
+import jakarta.mail.MessagingException;
+import jakarta.mail.internet.MimeMessage;
+import org.springframework.mail.MailException;
+import org.springframework.mail.javamail.JavaMailSender;
+import org.springframework.mail.javamail.MimeMessageHelper;
+
+/**
+ * Sends through Spring's {@link JavaMailSender} (SMTP settings come from {@code spring.mail.*}, i.e. the SMTP_* variables).
+ * The plain-text and the HTML version go out as one multipart/alternative message. A missing From address is a configuration
+ * error: the send fails (the caller records FAILED / SEND_ERROR) instead of inventing an address. Failures are rethrown as
+ * {@link EmailSendException} with a short code, so no address, server detail or credential can reach a log.
+ */
+public class SmtpEmailSender implements EmailSender {
+
+    private final JavaMailSender mailSender;
+    private final String from;
+
+    /**
+     * @param from     {@code SMTP_FROM}; may be blank
+     * @param username {@code SMTP_USERNAME}; used as From only when {@code from} is blank and it looks like an address
+     */
+    public SmtpEmailSender(JavaMailSender mailSender, String from, String username) {
+        this.mailSender = mailSender;
+        this.from = resolveFrom(from, username);
+    }
+
+    static String resolveFrom(String from, String username) {
+        if (from != null && !from.isBlank()) {
+            return from.trim();
+        }
+        if (username != null && username.contains("@")) {
+            return username.trim();
+        }
+        return null;
+    }
+
+    @Override
+    public Delivery send(EmailMessage message) {
+        if (from == null) {
+            throw new EmailSendException("SMTP_NO_FROM_ADDRESS");
+        }
+        try {
+            MimeMessage mime = mailSender.createMimeMessage();
+            MimeMessageHelper helper = new MimeMessageHelper(mime, true, "UTF-8");
+            helper.setFrom(from);
+            helper.setTo(message.to());
+            helper.setSubject(message.subject());
+            helper.setText(message.textBody(), message.htmlBody());
+            mailSender.send(mime);
+            return Delivery.SENT;
+        } catch (MessagingException | MailException e) {
+            throw new EmailSendException("SMTP_" + e.getClass().getSimpleName());
+        }
+    }
+}

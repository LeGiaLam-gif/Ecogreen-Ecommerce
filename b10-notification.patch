 ecogreen.payment.return-url=${PAYMENT_RETURN_URL:http://localhost:5173/payment/return}
 # TEMPORARY-COMPAT(B06): local mock provider + dev "mock pay" action. true is the development default; set false outside development.
 ecogreen.payment.mock-enabled=${PAYMENT_MOCK_ENABLED:true}

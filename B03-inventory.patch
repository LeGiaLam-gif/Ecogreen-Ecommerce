diff --git a/backend/src/main/resources/db/migration/V30__inventory.sql b/backend/src/main/resources/db/migration/V30__inventory.sql
new file mode 100644
index 0000000..9f45cce
--- /dev/null
+++ b/backend/src/main/resources/db/migration/V30__inventory.sql
@@ -0,0 +1,120 @@
+-- B03: inventory table (on-hand / reserved model) and CONVERSION of the legacy products.stock_quantity data into it.
+--
+-- LEGACY DATA IMPACT:        THIS SCRIPT CONVERTS EXISTING DATA. One inventory row is created for every existing product:
+--                              reserved_quantity = SUM(order_items.quantity) of the orders that are in PENDING_PAYMENT
+--                              quantity_on_hand  = products.stock_quantity + that same sum
+--                            Reason: the legacy model (and B05's adapter) already subtracted stock when an unpaid order was
+--                            created, so on-hand must be rebuilt to include goods that are merely reserved; otherwise the later
+--                            COMMIT of such an order would deduct them a second time. Orders in committed states (PAID ...
+--                            DELIVERED, legacy-mapped PROCESSING) need no adjustment. products.stock_quantity itself is NOT
+--                            changed: it stays as a frozen historical value that nothing reads or writes after B03.
+--                            Available stock (= on_hand - reserved) is never stored; it is computed when read.
+--                            HISTORICAL LEAK, NOT FIXED HERE: orders cancelled BEFORE B05's cutover never restored their stock.
+--                            This script never restocks them (whether the stock was corrected by hand is unknowable). Use the
+--                            read-only DIAGNOSTIC below and correct stock through the admin "adjust" operation if needed.
+-- NULLABILITY:               All four columns are NOT NULL with defaults (0 / CURRENT_TIMESTAMP); the table is new, so there is
+--                            nothing to backfill before NOT NULL. If ddl-auto=update already created the table from the entity it
+--                            has no defaults - the ALTER ... SET DEFAULT statements below add them.
+-- CONSTRAINT ORDER:          (1) create the table (primary key only), (2) set defaults, (3) CONVERT the data, (4) verify the data
+--                            satisfies the invariants and abort if not, (5) add the CHECKs, (6) add the foreign key. Every
+--                            constraint is added only if its name is not yet in pg_constraint, so re-running is safe.
+-- DATA-LOSS / ROLLBACK RISK: Dropping the table loses the reservation counters (and, with V31 applied, the ledger loses its
+--                            reference rows - drop V31's table first). The legacy value can be re-derived before dropping:
+--                              UPDATE products p SET stock_quantity = i.quantity_on_hand - i.reserved_quantity
+--                                FROM inventory i WHERE i.product_id = p.id;
+--                              DROP TABLE IF EXISTS inventory;     -- after DROP TABLE IF EXISTS inventory_transactions;
+--                            (Run the UPDATE only if nothing but B03 changed stock since V30; otherwise the frozen column is
+--                            already out of date for products whose stock changed through B03.)
+-- EMPTY DATABASE:            Fine - creates the empty table and its constraints; the conversion inserts nothing.
+-- EXISTING DATABASE:         Fine and idempotent - IF NOT EXISTS on the table, ON CONFLICT DO NOTHING on the conversion (a row that
+--                            already exists is never overwritten), guarded constraints.
+-- Requires V20 (status value PENDING_PAYMENT). Apply order: V20 -> V21 -> V22 -> V30 -> V31.
+--
+-- APPLY RULE (important): the entities Inventory and InventoryTransaction map product_id as a plain column, so with
+-- ddl-auto=update alone Hibernate would create these tables WITHOUT the foreign keys, CHECKs and the unique partial index of V31.
+-- Therefore apply V30 and then V31, in this order, with the application STOPPED and BEFORE its first start with B03 code.
+-- Applying V30 while the application is running would convert stock that keeps changing underneath the conversion.
+--
+-- DIAGNOSTIC (read-only, NOT executed by this script) - items of orders cancelled before B05's cutover. A cancelled order that
+-- went through B05 has a history row with a non-NULL old_status; one that was only backfilled by V21 does not:
+--   SELECT o.id AS order_id, o.created_at, oi.product_id, p.name, oi.quantity
+--     FROM orders o
+--     JOIN order_items oi ON oi.order_id = o.id
+--     JOIN products p     ON p.id = oi.product_id
+--    WHERE o.status = 'CANCELLED'
+--      AND NOT EXISTS (SELECT 1 FROM order_status_history h WHERE h.order_id = o.id AND h.old_status IS NOT NULL)
+--    ORDER BY o.id, oi.product_id;
+--
+-- VERIFICATION (read-only):
+--   -- one inventory row per product (expect 0 rows)
+--   SELECT p.id FROM products p WHERE NOT EXISTS (SELECT 1 FROM inventory i WHERE i.product_id = p.id);
+--   -- invariants (expect 0 rows)
+--   SELECT product_id FROM inventory WHERE quantity_on_hand < 0 OR reserved_quantity < 0 OR reserved_quantity > quantity_on_hand;
+--   -- conversion check: reserved equals the PENDING_PAYMENT demand, on_hand = frozen stock + reserved (expect 0 rows on a
+--   -- database where only V30 has run; after B03 starts changing stock, differences are expected)
+--   SELECT i.product_id FROM inventory i JOIN products p ON p.id = i.product_id
+--    WHERE i.reserved_quantity <> COALESCE((SELECT SUM(oi.quantity) FROM order_items oi JOIN orders o ON o.id = oi.order_id
+--                                            WHERE oi.product_id = i.product_id AND o.status = 'PENDING_PAYMENT'), 0)
+--       OR i.quantity_on_hand <> p.stock_quantity + i.reserved_quantity;
+--   -- expected constraints (expect exactly 5 rows: 3 checks, 1 foreign key, 1 primary key)
+--   SELECT conname, contype FROM pg_constraint WHERE conrelid = 'inventory'::regclass ORDER BY conname;
+--   --   chk_inventory_on_hand_nonneg (c), chk_inventory_reserved_le_on_hand (c), chk_inventory_reserved_nonneg (c),
+--   --   fk_inventory_product (f), inventory_pkey (p)
+--   -- expected defaults (expect 3 rows)
+--   SELECT column_name, column_default FROM information_schema.columns
+--    WHERE table_name = 'inventory' AND column_default IS NOT NULL ORDER BY column_name;
+
+CREATE TABLE IF NOT EXISTS inventory (
+    product_id        BIGINT    PRIMARY KEY,
+    quantity_on_hand  INT       NOT NULL DEFAULT 0,
+    reserved_quantity INT       NOT NULL DEFAULT 0,
+    updated_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+-- A table created earlier by ddl-auto=update has no defaults; make both paths identical.
+ALTER TABLE inventory ALTER COLUMN quantity_on_hand  SET DEFAULT 0;
+ALTER TABLE inventory ALTER COLUMN reserved_quantity SET DEFAULT 0;
+ALTER TABLE inventory ALTER COLUMN updated_at        SET DEFAULT CURRENT_TIMESTAMP;
+
+-- Legacy conversion (see LEGACY DATA IMPACT). A product that already has an inventory row is left exactly as it is.
+INSERT INTO inventory (product_id, quantity_on_hand, reserved_quantity)
+SELECT p.id,
+       p.stock_quantity + COALESCE(r.reserved, 0),
+       COALESCE(r.reserved, 0)
+  FROM products p
+  LEFT JOIN (SELECT oi.product_id, CAST(SUM(oi.quantity) AS INT) AS reserved
+               FROM order_items oi
+               JOIN orders o ON o.id = oi.order_id
+              WHERE o.status = 'PENDING_PAYMENT'
+              GROUP BY oi.product_id) r ON r.product_id = p.id
+ON CONFLICT (product_id) DO NOTHING;
+
+-- Verify BEFORE adding the CHECKs: if any row violates an invariant, stop here with a readable message instead of a bare
+-- constraint error. (Cannot happen for converted rows because stock_quantity >= 0, but rows may come from elsewhere.)
+DO $$
+DECLARE
+    bad INT;
+BEGIN
+    SELECT count(*) INTO bad FROM inventory
+     WHERE quantity_on_hand < 0 OR reserved_quantity < 0 OR reserved_quantity > quantity_on_hand;
+    IF bad > 0 THEN
+        RAISE EXCEPTION 'V30 aborted: % inventory row(s) violate reserved <= on_hand (or a negative value). Inspect: SELECT * FROM inventory WHERE quantity_on_hand < 0 OR reserved_quantity < 0 OR reserved_quantity > quantity_on_hand;', bad;
+    END IF;
+END $$;
+
+DO $$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_on_hand_nonneg' AND conrelid = 'inventory'::regclass) THEN
+        ALTER TABLE inventory ADD CONSTRAINT chk_inventory_on_hand_nonneg CHECK (quantity_on_hand >= 0);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_reserved_nonneg' AND conrelid = 'inventory'::regclass) THEN
+        ALTER TABLE inventory ADD CONSTRAINT chk_inventory_reserved_nonneg CHECK (reserved_quantity >= 0);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_reserved_le_on_hand' AND conrelid = 'inventory'::regclass) THEN
+        ALTER TABLE inventory ADD CONSTRAINT chk_inventory_reserved_le_on_hand CHECK (reserved_quantity <= quantity_on_hand);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_inventory_product' AND conrelid = 'inventory'::regclass) THEN
+        ALTER TABLE inventory ADD CONSTRAINT fk_inventory_product
+            FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE;
+    END IF;
+END $$;
diff --git a/backend/src/main/resources/db/migration/V31__inventory_transactions.sql b/backend/src/main/resources/db/migration/V31__inventory_transactions.sql
new file mode 100644
index 0000000..e135b1b
--- /dev/null
+++ b/backend/src/main/resources/db/migration/V31__inventory_transactions.sql
@@ -0,0 +1,121 @@
+-- B03: append-only inventory ledger (one row per stock change) plus one opening-balance row per existing inventory row.
+--
+-- LEGACY DATA IMPACT:        No existing table is changed. One ledger row is ADDED for every inventory row that has no ledger row
+--                            yet: change_type 'ADJUST', quantity = on_hand at conversion time, on_hand_after / reserved_after =
+--                            the converted values of V30, reason 'Opening balance (V30)', actor NULL. That row is the starting
+--                            point of the history ("why is stock 3?"). Legacy reserved units (unpaid orders created before B03)
+--                            get NO RESERVE rows: their later COMMIT / RELEASE rows carry the normal references.
+--                            LEDGER RECONCILIATION RULE: the ledger is reconciled through the *_after columns, NOT by summing
+--                            quantities. The last row of a product (highest id) must show on_hand_after / reserved_after equal
+--                            to that product's inventory row (query below). Summing deltas is wrong because of the legacy
+--                            reserved units and because quantity means different things per change_type.
+-- NULLABILITY:               New table. product_id, change_type, quantity, on_hand_after, reserved_after, created_at are NOT NULL
+--                            (stricter than "INT": the application always writes both after-values and reconciliation relies on
+--                            them). reference_type / reference_id (both set or both NULL), reason, actor_user_id are nullable by
+--                            design: initial stock and admin adjustments have no order, system movements have no actor.
+-- CONSTRAINT ORDER:          (1) create the table, (2) set defaults, (3) add CHECKs and foreign keys (the referenced tables
+--                            products and users already exist), (4) create the indexes, (5) write the opening rows last, so the
+--                            table is fully constrained before data goes in. Constraints and indexes are only created if absent.
+-- DATA-LOSS / ROLLBACK RISK: Dropping the table loses the whole stock audit trail written after B03 went live (the opening rows
+--                            can be recreated by re-running this script after the drop, but with the CURRENT inventory values).
+--                            Manual rollback:  DROP TABLE IF EXISTS inventory_transactions;
+--                            Deleting a user sets actor_user_id to NULL (ON DELETE SET NULL) and keeps the row. Deleting a
+--                            product is RESTRICTED while it has ledger rows (the ledger is an audit trail; the application never
+--                            hard-deletes products - only database/seed-data.sql does, and it clears the ledger first).
+-- EMPTY DATABASE:            Fine - creates the empty table; the opening-row insert adds nothing.
+-- EXISTING DATABASE:         Fine and idempotent - IF NOT EXISTS / guarded constraints, and the opening rows are guarded by
+--                            NOT EXISTS (a product that already has any ledger row is skipped), so re-running never duplicates.
+-- Requires V30 (inventory rows) and the users table. Apply order: V30 -> V31.
+--
+-- APPLY RULE: apply V30 then V31, in this order, with the application STOPPED and BEFORE its first start with B03 code (see V30).
+-- With ddl-auto=update alone the table would exist WITHOUT these CHECKs, foreign keys and the unique partial index.
+--
+-- INDEXES (each is backed by a real query):
+--   idx_inventory_tx_product_created (product_id, created_at DESC, id DESC) <- GET /api/v1/admin/inventory/{id}/transactions
+--                                                                              (WHERE product_id = ? ORDER BY created_at DESC, id DESC)
+--   uq_inventory_tx_idempotency      UNIQUE (product_id, change_type, reference_type, reference_id)
+--                                    WHERE change_type <> 'ADJUST' AND reference_type IS NOT NULL AND reference_id IS NOT NULL
+--                                    <- a RESERVE / RELEASE / COMMIT / RESTOCK for the same product and reference can only be
+--                                       applied once (retries and webhook replays are logged no-ops in the service).
+--                                       ADJUST rows are excluded (an admin may adjust the same product many times); rows without a
+--                                       reference (initial stock, seed) are excluded because they have nothing to repeat.
+--
+-- VERIFICATION (read-only):
+--   -- expected constraints (expect exactly 7 rows: 4 checks, 2 foreign keys, 1 primary key):
+--   SELECT conname, contype FROM pg_constraint WHERE conrelid = 'inventory_transactions'::regclass ORDER BY conname;
+--   --   chk_inventory_tx_after_values (c), chk_inventory_tx_quantity (c), chk_inventory_tx_reference_pair (c),
+--   --   chk_inventory_tx_type (c), fk_inventory_tx_actor (f), fk_inventory_tx_product (f), inventory_transactions_pkey (p)
+--   -- expected indexes (expect 3 rows: the primary key and the two below)
+--   SELECT indexname FROM pg_indexes WHERE tablename = 'inventory_transactions' ORDER BY indexname;
+--   --   idx_inventory_tx_product_created, inventory_transactions_pkey, uq_inventory_tx_idempotency
+--   -- the idempotency index is partial and unique (expect indisunique = true and the WHERE text in the definition)
+--   SELECT indexdef FROM pg_indexes WHERE indexname = 'uq_inventory_tx_idempotency';
+--   -- every inventory row has at least one ledger row (expect 0 rows)
+--   SELECT i.product_id FROM inventory i WHERE NOT EXISTS (SELECT 1 FROM inventory_transactions t WHERE t.product_id = i.product_id);
+--   -- RECONCILIATION through the *_after columns: the last ledger row equals the inventory row (expect 0 rows)
+--   SELECT i.product_id, i.quantity_on_hand, i.reserved_quantity, l.on_hand_after, l.reserved_after
+--     FROM inventory i
+--     LEFT JOIN LATERAL (SELECT t.on_hand_after, t.reserved_after FROM inventory_transactions t
+--                         WHERE t.product_id = i.product_id ORDER BY t.id DESC LIMIT 1) l ON TRUE
+--    WHERE l.on_hand_after  IS DISTINCT FROM i.quantity_on_hand
+--       OR l.reserved_after IS DISTINCT FROM i.reserved_quantity;
+
+CREATE TABLE IF NOT EXISTS inventory_transactions (
+    id             BIGSERIAL    PRIMARY KEY,
+    product_id     BIGINT       NOT NULL,
+    change_type    VARCHAR(10)  NOT NULL,
+    quantity       INT          NOT NULL,
+    on_hand_after  INT          NOT NULL,
+    reserved_after INT          NOT NULL,
+    reference_type VARCHAR(30),
+    reference_id   BIGINT,
+    reason         VARCHAR(255),
+    actor_user_id  BIGINT,
+    created_at     TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+-- A table created earlier by ddl-auto=update has no default; make both paths identical.
+ALTER TABLE inventory_transactions ALTER COLUMN created_at SET DEFAULT CURRENT_TIMESTAMP;
+
+DO $$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_tx_type' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT chk_inventory_tx_type
+            CHECK (change_type IN ('RESERVE', 'RELEASE', 'COMMIT', 'RESTOCK', 'ADJUST'));
+    END IF;
+    -- quantity is the (positive) amount for RESERVE / RELEASE / COMMIT / RESTOCK and the signed delta for ADJUST
+    -- (0 is allowed only for ADJUST, so an opening balance of 0 can be recorded).
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_tx_quantity' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT chk_inventory_tx_quantity
+            CHECK (change_type = 'ADJUST' OR quantity > 0);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_tx_after_values' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT chk_inventory_tx_after_values
+            CHECK (on_hand_after >= 0 AND reserved_after >= 0 AND reserved_after <= on_hand_after);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_inventory_tx_reference_pair' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT chk_inventory_tx_reference_pair
+            CHECK ((reference_type IS NULL) = (reference_id IS NULL));
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_inventory_tx_product' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT fk_inventory_tx_product
+            FOREIGN KEY (product_id) REFERENCES products(id);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'fk_inventory_tx_actor' AND conrelid = 'inventory_transactions'::regclass) THEN
+        ALTER TABLE inventory_transactions ADD CONSTRAINT fk_inventory_tx_actor
+            FOREIGN KEY (actor_user_id) REFERENCES users(id) ON DELETE SET NULL;
+    END IF;
+END $$;
+
+CREATE INDEX IF NOT EXISTS idx_inventory_tx_product_created
+    ON inventory_transactions (product_id, created_at DESC, id DESC);
+
+CREATE UNIQUE INDEX IF NOT EXISTS uq_inventory_tx_idempotency
+    ON inventory_transactions (product_id, change_type, reference_type, reference_id)
+    WHERE change_type <> 'ADJUST' AND reference_type IS NOT NULL AND reference_id IS NOT NULL;
+
+-- Opening balance: the starting point of each product's history (see LEGACY DATA IMPACT). Written last, guarded per product.
+INSERT INTO inventory_transactions (product_id, change_type, quantity, on_hand_after, reserved_after, reason)
+SELECT i.product_id, 'ADJUST', i.quantity_on_hand, i.quantity_on_hand, i.reserved_quantity, 'Opening balance (V30)'
+  FROM inventory i
+ WHERE NOT EXISTS (SELECT 1 FROM inventory_transactions t WHERE t.product_id = i.product_id);

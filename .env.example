# Copy this file to .env and set real values. Never commit the real .env file.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecogreen
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Google Sign-In (names only - set real values in your own .env / environment, never commit them)
# Backend: OAuth 2.0 Web client ID used as the expected "aud" of Google ID tokens. If empty, Google login is disabled (fails closed).
GOOGLE_CLIENT_ID=
# Frontend (Vite): the same OAuth 2.0 Web client ID, read at build time. This is the ONLY source of the client ID.
VITE_GOOGLE_CLIENT_ID=

# JWT signing key for access tokens (REQUIRED - the backend fails to start without it). At least 32 bytes of random data, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# Directory where uploaded product images are stored (outside the repo is best; relative paths are resolved from the backend working directory)
UPLOAD_DIR=./uploads

# Shipping fee in VND (B04, decision D-10): the flat fee, and the items total from which shipping is free (inclusive)
SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# Payment gateway (B06). VNPay sandbox credentials (names only - never commit real values). Empty = VNPAY fails closed.
PAYMENT_VNPAY_TMN_CODE=...
PAYMENT_VNPAY_SECRET=...
# VNPay payment page (default: the sandbox URL)
PAYMENT_VNPAY_URL=...
# Frontend return page after paying, e.g. http://localhost:5173/payment/return
PAYMENT_RETURN_URL=...
# true enables the local mock provider and the dev "mock pay" buttons (development only; use false elsewhere)
PAYMENT_MOCK_ENABLED=...

# Notification email (B10). Empty SMTP_HOST = emails are not sent (only the notification type and user id are logged).
SMTP_HOST=...
SMTP_PORT=587
SMTP_USERNAME=...
SMTP_PASSWORD=...
# Sender address, e.g. no-reply@yourdomain (must be allowed by the SMTP account). Empty = SMTP_USERNAME when it is an email address
SMTP_FROM=...
# false for a local catch-all server without login or TLS (e.g. MailHog); true (default) for a real provider on port 587
SMTP_AUTH=...
SMTP_STARTTLS=...

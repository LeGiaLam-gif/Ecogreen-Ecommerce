# EcoGreen environment variables. Names only: set real values in your own environment, never commit them.
#
# How these are read
#   - Backend: Spring reads the process environment (export the variables, or set them in your IDE run configuration).
#     It does NOT load a .env file by itself.
#   - Frontend: Vite reads VITE_* variables from frontend/.env (or the environment) at build/dev-server start.
#
# REQUIRED = the application cannot work without it. Everything else is optional; the default is shown in brackets.

# ── Backend: authentication ───────────────────────────────────────────
# REQUIRED. JWT signing key, at least 32 bytes of random data (the backend refuses to start without it), e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# Google Sign-In (backend). OAuth 2.0 Web client ID, the expected "aud" of Google ID tokens.
# Empty = Google login is disabled (POST /api/v1/auth/google fails closed).
GOOGLE_CLIENT_ID=

# ── Backend: uploads ──────────────────────────────────────────────────
# Directory for uploaded product and return images. Relative paths resolve from the backend working directory. [./uploads]
UPLOAD_DIR=./uploads

# ── Backend: shipping fee (VND) ───────────────────────────────────────
# Flat fee, and the items total from which shipping is free (inclusive). [30000 / 500000]
SHIPPING_FLAT_FEE=30000
FREE_SHIPPING_THRESHOLD=500000

# ── Backend: payment (B06) ────────────────────────────────────────────
# VNPay credentials. Empty = the VNPAY provider fails closed (initiate answers 400, the webhook is not recorded).
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_SECRET=
# VNPay payment page. Empty = the built-in default (the VNPay sandbox URL).
PAYMENT_VNPAY_URL=
# Frontend page the gateway returns the browser to. Empty = the built-in default (http://localhost:5173/payment/return).
PAYMENT_RETURN_URL=
# TEMPORARY-COMPAT(B06). true enables the local MOCK provider and the "mock pay" endpoint.
# application.properties defaults this to true when the variable is unset; set false everywhere except local development.
PAYMENT_MOCK_ENABLED=false

# ── Backend: notification email (B10) ─────────────────────────────────
# Empty SMTP_HOST = no email is sent (the notification is logged as FAILED / EMAIL_NOT_CONFIGURED).
SMTP_HOST=
# [587]
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address (must be allowed by the SMTP account). Empty = SMTP_USERNAME when that is an email address.
SMTP_FROM=
# [true] Set false for a local catch-all server without login or TLS (e.g. MailHog).
SMTP_AUTH=true
# [true]
SMTP_STARTTLS=true

# ── Web / links (B01) ──────────────────────────────────────────────────
# Origin patterns allowed to call the API (comma separated). Default: any localhost / 127.0.0.1 port. Production: the exact origin.
# [http://localhost:*,http://127.0.0.1:*]
CORS_ALLOWED_ORIGINS=
# Public frontend URL used in the password-reset email link. [http://localhost:5173]
APP_PUBLIC_URL=

# ── Facebook Login (B01) ───────────────────────────────────────────────
# From Meta for Developers > your app > Settings > Basic. Empty = Facebook login is disabled (503). Never commit the secret.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Graph API version used for server-side verification. [v21.0]
FACEBOOK_GRAPH_VERSION=

# ── Frontend (put in frontend/.env) ───────────────────────────────────
# The same OAuth 2.0 Web client ID as GOOGLE_CLIENT_ID. This is the only place the frontend reads it from.
VITE_GOOGLE_CLIENT_ID=
# The same Facebook App ID as FACEBOOK_APP_ID (public value, not the secret).
VITE_FACEBOOK_APP_ID=

# ── Database (read by application.properties and docker/docker-compose.yml) ──────────────────────
# DB_PASSWORD has no default: set it, in the IDE run configuration or the terminal (Spring does not read this file).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecogreen
DB_USERNAME=postgres
DB_PASSWORD=

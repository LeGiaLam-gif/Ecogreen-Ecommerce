+package com.example.backend.controller;
+
+import com.example.backend.dto.CartItemResponse;
+import com.example.backend.dto.CartResponse;
+import com.example.backend.exception.BadRequestException;
+import com.example.backend.exception.GlobalExceptionHandler;
+import com.example.backend.exception.ResourceNotFoundException;
+import com.example.backend.security.AuthInterceptor;
+import com.example.backend.security.CurrentUser;
+import com.example.backend.service.CartService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/** B04 /api/v1/cart: the owner comes from the token, bodies are typed, every mutation answers with the whole cart. */
+class CartV1ControllerTest {
+
+    private static final String JSON = MediaType.APPLICATION_JSON_VALUE;
+    private static final long CALLER = 42L;
+
+    private CartService service;
+    private MockMvc mvc;
+
+    @BeforeEach
+    void setUp() {
+        service = mock(CartService.class);
+        CartV1Controller controller = new CartV1Controller();
+        ReflectionTestUtils.setField(controller, "cartService", service);
+        mvc = MockMvcBuilders.standaloneSetup(controller).setControllerAdvice(new GlobalExceptionHandler()).build();
+
+        CartItemResponse line = new CartItemResponse();
+        line.id = 11L;
+        line.quantity = 3;
+        line.subtotal = new BigDecimal("300000");
+        line.availableQuantity = 2;
+        line.warning = "Sản phẩm \"Bình nước\" chỉ còn 2 sản phẩm trong kho.";
+        CartResponse cart = new CartResponse();
+        cart.cartId = 50L;
+        cart.items = List.of(line);
+        cart.totalPrice = new BigDecimal("300000");
+        cart.totalItems = 3;
+        when(service.getCart(CALLER)).thenReturn(cart);
+        when(service.addItem(anyLong(), anyLong(), anyInt())).thenReturn(cart);
+        when(service.updateQuantity(anyLong(), anyLong(), anyInt())).thenReturn(cart);
+        when(service.removeItem(anyLong(), anyLong())).thenReturn(cart);
+    }
+
+    private static MockHttpServletRequestBuilder asCustomer(MockHttpServletRequestBuilder b) {
+        return b.requestAttr(AuthInterceptor.REQUEST_ATTR, new CurrentUser(CALLER, List.of("CUSTOMER"), List.of()));
+    }
+
+    @Test
+    void everyEndpoint_withoutToken_is401() throws Exception {
+        mvc.perform(get("/api/v1/cart")).andExpect(status().isUnauthorized()).andExpect(jsonPath("$.error.code").value("UNAUTHENTICATED"));
+        mvc.perform(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":7}")).andExpect(status().isUnauthorized());
+        mvc.perform(patch("/api/v1/cart/items/11").contentType(JSON).content("{\"quantity\":2}")).andExpect(status().isUnauthorized());
+        mvc.perform(delete("/api/v1/cart/items/11")).andExpect(status().isUnauthorized());
+        mvc.perform(delete("/api/v1/cart")).andExpect(status().isUnauthorized());
+    }
+
+    @Test
+    void cart_response_includesAvailableQuantity_andTheServerWarning() throws Exception {
+        mvc.perform(asCustomer(get("/api/v1/cart")))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.cartId").value(50))
+                .andExpect(jsonPath("$.data.items[0].availableQuantity").value(2))
+                .andExpect(jsonPath("$.data.items[0].warning").value("Sản phẩm \"Bình nước\" chỉ còn 2 sản phẩm trong kho."))
+                .andExpect(jsonPath("$.data.totalItems").value(3));
+        verify(service).getCart(CALLER);
+    }
+
+    @Test
+    void addItem_usesTheTokenUser_andDefaultsTheQuantityToOne() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":7}")))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.data.items[0].id").value(11));
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":8,\"quantity\":3,\"userId\":999}")))
+                .andExpect(status().isOk());
+
+        verify(service).addItem(CALLER, 7L, 1);
+        verify(service).addItem(CALLER, 8L, 3); // the userId in the body is ignored
+    }
+
+    @Test
+    void addItem_invalidBody_is400ValidationError() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{}")))
+                .andExpect(status().isBadRequest()).andExpect(jsonPath("$.error.code").value("VALIDATION_ERROR"))
+                .andExpect(jsonPath("$.error.fields.productId").exists());
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":7,\"quantity\":0}")))
+                .andExpect(status().isBadRequest()).andExpect(jsonPath("$.error.fields.quantity").exists());
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":7,\"quantity\":1001}")))
+                .andExpect(status().isBadRequest());
+        verify(service, never()).addItem(anyLong(), anyLong(), anyInt());
+    }
+
+    @Test
+    void addItem_notEnoughStock_is400_withTheServerMessage() throws Exception {
+        when(service.addItem(anyLong(), anyLong(), anyInt())).thenThrow(new BadRequestException("Kho chỉ còn 2 sản phẩm."));
+
+        mvc.perform(asCustomer(post("/api/v1/cart/items").contentType(JSON).content("{\"productId\":7,\"quantity\":5}")))
+                .andExpect(status().isBadRequest()).andExpect(jsonPath("$.error.message").value("Kho chỉ còn 2 sản phẩm."));
+    }
+
+    @Test
+    void updateItem_isAPatch_withTheTokenUser() throws Exception {
+        mvc.perform(asCustomer(patch("/api/v1/cart/items/11").contentType(JSON).content("{\"quantity\":2}"))).andExpect(status().isOk());
+
+        verify(service).updateQuantity(CALLER, 11L, 2);
+    }
+
+    @Test
+    void legacyPutOnTheItem_isGone() throws Exception {
+        int httpStatus = mvc.perform(asCustomer(put("/api/v1/cart/items/11").contentType(JSON).content("{\"quantity\":2}")))
+                .andReturn().getResponse().getStatus();
+
+        // not mapped any more: the request is refused (the exact code depends on GlobalExceptionHandler's catch-all) and does nothing
+        org.junit.jupiter.api.Assertions.assertTrue(httpStatus >= 400, "PUT must not succeed, was " + httpStatus);
+        verify(service, never()).updateQuantity(anyLong(), anyLong(), anyInt());
+    }
+
+    @Test
+    void updateItem_invalidQuantity_is400() throws Exception {
+        mvc.perform(asCustomer(patch("/api/v1/cart/items/11").contentType(JSON).content("{}"))).andExpect(status().isBadRequest());
+        mvc.perform(asCustomer(patch("/api/v1/cart/items/11").contentType(JSON).content("{\"quantity\":-1}"))).andExpect(status().isBadRequest());
+        verify(service, never()).updateQuantity(anyLong(), anyLong(), anyInt());
+    }
+
+    @Test
+    void someoneElsesItem_looksLikeAMissingOne_404() throws Exception {
+        when(service.updateQuantity(CALLER, 99L, 2)).thenThrow(new ResourceNotFoundException("Không tìm thấy sản phẩm trong giỏ hàng #99"));
+        when(service.removeItem(CALLER, 99L)).thenThrow(new ResourceNotFoundException("Không tìm thấy sản phẩm trong giỏ hàng #99"));
+
+        mvc.perform(asCustomer(patch("/api/v1/cart/items/99").contentType(JSON).content("{\"quantity\":2}")))
+                .andExpect(status().isNotFound()).andExpect(jsonPath("$.error.code").value("NOT_FOUND"));
+        mvc.perform(asCustomer(delete("/api/v1/cart/items/99"))).andExpect(status().isNotFound());
+    }
+
+    @Test
+    void removeItem_answersWithTheCart_andClearAnswers204() throws Exception {
+        mvc.perform(asCustomer(delete("/api/v1/cart/items/11"))).andExpect(status().isOk()).andExpect(jsonPath("$.data.cartId").value(50));
+        mvc.perform(asCustomer(delete("/api/v1/cart"))).andExpect(status().isNoContent());
+
+        verify(service).removeItem(CALLER, 11L);
+        verify(service).clear(CALLER);
+    }
+}

+package com.example.backend.controller;
+
+import com.example.backend.dto.CheckoutPreviewResponse;
+import com.example.backend.dto.CheckoutRequest;
+import com.example.backend.entity.Order;
+import com.example.backend.entity.OrderItem;
+import com.example.backend.exception.BusinessRuleViolationException;
+import com.example.backend.exception.ForbiddenException;
+import com.example.backend.exception.GlobalExceptionHandler;
+import com.example.backend.security.AuthInterceptor;
+import com.example.backend.security.CurrentUser;
+import com.example.backend.service.CheckoutService;
+import com.example.backend.service.inventory.InsufficientStockException;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.http.MediaType;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import java.math.BigDecimal;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/** B04 checkout endpoints: the customer is the token user, the body is typed and ignores extra fields, errors keep the /api/v1 shape. */
+class CheckoutV1ControllerTest {
+
+    private static final String JSON = MediaType.APPLICATION_JSON_VALUE;
+    private static final long CALLER = 42L;
+    private static final String BODY = "{\"customerName\":\"An\",\"customerPhone\":\"0900000000\",\"shippingAddress\":\"1 Lê Lợi\","
+            + "\"discountCode\":\"SALE10\",\"paymentMethod\":\"COD\"}";
+
+    private CheckoutService service;
+    private MockMvc mvc;
+
+    @BeforeEach
+    void setUp() {
+        service = mock(CheckoutService.class);
+        CheckoutV1Controller controller = new CheckoutV1Controller();
+        ReflectionTestUtils.setField(controller, "checkoutService", service);
+        mvc = MockMvcBuilders.standaloneSetup(controller).setControllerAdvice(new GlobalExceptionHandler()).build();
+
+        Order order = new Order();
+        order.setId(100L);
+        order.setTotalPrice(new BigDecimal("280000.00"));
+        when(service.checkout(anyLong(), any(CheckoutRequest.class)))
+                .thenReturn(new CheckoutService.PlacedOrder(order, List.of(new OrderItem())));
+        CheckoutPreviewResponse preview = new CheckoutPreviewResponse();
+        preview.items = List.of(new CheckoutPreviewResponse.Line(10L, "Bình nước", new BigDecimal("100000"), 2, new BigDecimal("200000.00"), 5));
+        preview.subtotal = new BigDecimal("200000.00");
+        preview.discountAmount = new BigDecimal("0.00");
+        preview.shippingFee = new BigDecimal("30000.00");
+        preview.total = new BigDecimal("230000.00");
+        preview.issues = List.of(new CheckoutPreviewResponse.Issue(null, "DISCOUNT_INVALID", "Mã giảm giá không hợp lệ hoặc đã hết hạn."));
+        when(service.preview(anyLong(), any(CheckoutRequest.class))).thenReturn(preview);
+    }
+
+    private static MockHttpServletRequestBuilder asCustomer(MockHttpServletRequestBuilder b) {
+        return b.requestAttr(AuthInterceptor.REQUEST_ATTR, new CurrentUser(CALLER, List.of("CUSTOMER"), List.of()));
+    }
+
+    @Test
+    void bothEndpoints_withoutToken_are401() throws Exception {
+        mvc.perform(post("/api/v1/checkout").contentType(JSON).content(BODY))
+                .andExpect(status().isUnauthorized()).andExpect(jsonPath("$.error.code").value("UNAUTHENTICATED"));
+        mvc.perform(post("/api/v1/checkout/preview").contentType(JSON).content(BODY)).andExpect(status().isUnauthorized());
+        verify(service, never()).checkout(anyLong(), any());
+        verify(service, never()).preview(anyLong(), any());
+    }
+
+    @Test
+    void checkout_returns201WithTheOrder_forTheTokenUser() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content(BODY)))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.data.id").value(100))
+                .andExpect(jsonPath("$.data.totalPrice").value(280000.0));
+
+        ArgumentCaptor<CheckoutRequest> body = ArgumentCaptor.forClass(CheckoutRequest.class);
+        verify(service).checkout(org.mockito.ArgumentMatchers.eq(CALLER), body.capture());
+        assertEquals("SALE10", body.getValue().discountCode());
+        assertEquals("COD", body.getValue().paymentMethod());
+        assertEquals("1 Lê Lợi", body.getValue().shippingAddress());
+    }
+
+    @Test
+    void checkout_ignoresClientSuppliedPriceTotalDiscountStatusAndUserId() throws Exception {
+        String hostile = "{\"userId\":999,\"price\":1,\"total\":1,\"totalPrice\":1,\"subtotal\":1,\"discountAmount\":999999,"
+                + "\"shippingFee\":0,\"status\":\"PAID\",\"customerName\":\"An\",\"customerPhone\":\"0900000000\","
+                + "\"shippingAddress\":\"1 Lê Lợi\",\"paymentMethod\":\"COD\"}";
+
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content(hostile))).andExpect(status().isCreated());
+
+        ArgumentCaptor<CheckoutRequest> body = ArgumentCaptor.forClass(CheckoutRequest.class);
+        verify(service).checkout(org.mockito.ArgumentMatchers.eq(CALLER), body.capture()); // 42 from the token, not 999
+        assertEquals("An", body.getValue().customerName());
+        assertNull(body.getValue().discountCode());
+        assertNull(body.getValue().addressId());
+    }
+
+    @Test
+    void checkout_withASavedAddressId_bindsIt() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content("{\"addressId\":7,\"paymentMethod\":\"MOMO\"}")))
+                .andExpect(status().isCreated());
+
+        ArgumentCaptor<CheckoutRequest> body = ArgumentCaptor.forClass(CheckoutRequest.class);
+        verify(service).checkout(org.mockito.ArgumentMatchers.eq(CALLER), body.capture());
+        assertEquals(7L, body.getValue().addressId());
+    }
+
+    @Test
+    void checkout_oversizedFields_are400ValidationError() throws Exception {
+        String longName = "x".repeat(101);
+
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON)
+                        .content(BODY.replace("\"An\"", "\"" + longName + "\""))))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.error.code").value("VALIDATION_ERROR"))
+                .andExpect(jsonPath("$.error.fields.customerName").exists());
+        verify(service, never()).checkout(anyLong(), any());
+    }
+
+    @Test
+    void checkout_emptyCart_is400BusinessRuleViolation() throws Exception {
+        when(service.checkout(anyLong(), any())).thenThrow(new BusinessRuleViolationException("Giỏ hàng của bạn đang trống."));
+
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content(BODY)))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.error.code").value("BUSINESS_RULE_VIOLATION"))
+                .andExpect(jsonPath("$.error.message").value("Giỏ hàng của bạn đang trống."));
+    }
+
+    @Test
+    void checkout_insufficientStock_is400_namingTheProduct() throws Exception {
+        when(service.checkout(anyLong(), any())).thenThrow(new InsufficientStockException(10L, 3, "Bình nước"));
+
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content(BODY)))
+                .andExpect(status().isBadRequest())
+                .andExpect(jsonPath("$.error.code").value("BUSINESS_RULE_VIOLATION"))
+                .andExpect(jsonPath("$.error.message").value("Sản phẩm \"Bình nước\" không đủ số lượng tồn kho."));
+    }
+
+    @Test
+    void checkout_addressOfAnotherUser_is403() throws Exception {
+        when(service.checkout(anyLong(), any())).thenThrow(new ForbiddenException("Bạn không có quyền truy cập địa chỉ này."));
+
+        mvc.perform(asCustomer(post("/api/v1/checkout").contentType(JSON).content("{\"addressId\":9,\"paymentMethod\":\"COD\"}")))
+                .andExpect(status().isForbidden()).andExpect(jsonPath("$.error.code").value("FORBIDDEN"));
+    }
+
+    @Test
+    void preview_returnsTheServersBreakdown_andIssues() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/checkout/preview").contentType(JSON).content(BODY)))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.data.subtotal").value(200000.0))
+                .andExpect(jsonPath("$.data.discountAmount").value(0.0))
+                .andExpect(jsonPath("$.data.shippingFee").value(30000.0))
+                .andExpect(jsonPath("$.data.total").value(230000.0))
+                .andExpect(jsonPath("$.data.items[0].productId").value(10))
+                .andExpect(jsonPath("$.data.items[0].unitPrice").value(100000))
+                .andExpect(jsonPath("$.data.items[0].lineTotal").value(200000.0))
+                .andExpect(jsonPath("$.data.items[0].available").value(5))
+                .andExpect(jsonPath("$.data.issues[0].code").value("DISCOUNT_INVALID"));
+        verify(service).preview(org.mockito.ArgumentMatchers.eq(CALLER), any(CheckoutRequest.class));
+        verify(service, never()).checkout(anyLong(), any());
+    }
+
+    @Test
+    void preview_withoutABody_isAllowed() throws Exception {
+        mvc.perform(asCustomer(post("/api/v1/checkout/preview"))).andExpect(status().isOk());
+
+        verify(service).preview(org.mockito.ArgumentMatchers.eq(CALLER), any(CheckoutRequest.class));

@@ -0,0 +1,64 @@
+package com.example.backend.controller;
+
+import com.example.backend.api.ApiResponse;
+import com.example.backend.dto.AddCartItemRequest;
+import com.example.backend.dto.CartResponse;
+import com.example.backend.dto.UpdateCartItemRequest;
+import com.example.backend.exception.UnauthorizedException;
+import com.example.backend.security.AuthInterceptor;
+import com.example.backend.security.CurrentUser;
+import com.example.backend.service.CartService;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.validation.Valid;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+/**
+ * The cart always belongs to the AUTHENTICATED user from the verified token - never to an id supplied by the client - so it is
+ * the same on every device. Any logged-in user may use it; the rights are ownership-based (no permission code). Every
+ * mutation answers with the whole cart ({@code availableQuantity} and a server-written {@code warning} per item).
+ */
+@RestController
+@RequestMapping("/api/v1/cart")
+public class CartV1Controller {
+
+    @Autowired private CartService cartService;
+
+    @GetMapping
+    public ApiResponse<CartResponse> get(HttpServletRequest request) {
+        return ApiResponse.of(cartService.getCart(requireCurrent(request).getUserId()));
+    }
+
+    @PostMapping("/items")
+    public ApiResponse<CartResponse> addItem(@Valid @RequestBody AddCartItemRequest body, HttpServletRequest request) {
+        CurrentUser current = requireCurrent(request);
+        return ApiResponse.of(cartService.addItem(current.getUserId(), body.productId(), body.quantityOrDefault()));
+    }
+
+    @PatchMapping("/items/{id}")
+    public ApiResponse<CartResponse> updateItem(@PathVariable Long id, @Valid @RequestBody UpdateCartItemRequest body,
+                                                HttpServletRequest request) {
+        CurrentUser current = requireCurrent(request);
+        return ApiResponse.of(cartService.updateQuantity(current.getUserId(), id, body.quantity()));
+    }
+
+    @DeleteMapping("/items/{id}")
+    public ApiResponse<CartResponse> removeItem(@PathVariable Long id, HttpServletRequest request) {
+        return ApiResponse.of(cartService.removeItem(requireCurrent(request).getUserId(), id));
+    }
+
+    @DeleteMapping
+    public ResponseEntity<Void> clear(HttpServletRequest request) {
+        cartService.clear(requireCurrent(request).getUserId());
+        return ResponseEntity.noContent().build();
+    }
+
+    private static CurrentUser requireCurrent(HttpServletRequest request) {
+        CurrentUser current = (CurrentUser) request.getAttribute(AuthInterceptor.REQUEST_ATTR);
+        if (current == null) {
+            throw new UnauthorizedException("Vui lòng đăng nhập để tiếp tục.");
+        }
+        return current;
+    }
+}

index 0000000..6bf5ba9
--- /dev/null
+++ b/backend/src/main/java/com/example/backend/service/DiscountService.java
@@ -0,0 +1,153 @@
+package com.example.backend.service;
+
+import com.example.backend.dto.DiscountRequest;
+import com.example.backend.entity.Discount;
+import com.example.backend.exception.BadRequestException;
+import com.example.backend.exception.BusinessRuleViolationException;
+import com.example.backend.exception.ConflictException;
+import com.example.backend.exception.ResourceNotFoundException;
+import com.example.backend.repository.DiscountRepository;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDateTime;
+import java.util.Locale;
+
+/**
+ * B04 discount codes: the pure pricing rule used by checkout / preview ({@link #resolve}) and the admin CRUD.
+ *
+ * <p>Rules: the code is matched case-insensitively and stored upper-case; a code is usable when it exists, is active, is inside
+ * {@code valid_from .. valid_to} (open ends allowed, both bounds inclusive) and the subtotal reaches {@code min_order_amount}.
+ * A percent discount is rounded to whole VND with {@code HALF_UP}; the discount never exceeds the subtotal. Every failure
+ * is the SAME generic message, so a caller cannot tell a code that does not exist from one that expired.
+ */
+@Service
+public class DiscountService {
+
+    /** Deliberately identical for unknown, inactive, not yet valid, expired and below-minimum codes (no enumeration hints). */
+    public static final String INVALID_MESSAGE = "Mã giảm giá không hợp lệ hoặc đã hết hạn.";
+
+    /** Thrown by {@link #resolve}; a business-rule violation (400) that the preview catches to report an issue instead. */
+    public static class InvalidDiscountException extends BusinessRuleViolationException {
+        public InvalidDiscountException() { super(INVALID_MESSAGE); }
+    }
+
+    /** The code as stored (upper-case) and the amount it takes off, scale 2. */
+    public record Applied(String code, BigDecimal amount) {}
+
+    @Autowired private DiscountRepository discountRepository;
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Pricing
+    // ------------------------------------------------------------------------------------------------------------
+
+    /** Validates {@code rawCode} for {@code subtotal} at {@code now} and computes the discount. Read-only, no side effect. */
+    @Transactional(readOnly = true)
+    public Applied resolve(String rawCode, BigDecimal subtotal, LocalDateTime now) {
+        String code = normalize(rawCode);
+        if (code == null) throw new InvalidDiscountException();
+        Discount discount = discountRepository.findByCode(code).orElseThrow(InvalidDiscountException::new);
+        if (!discount.isActive()) throw new InvalidDiscountException();
+        if (discount.getValidFrom() != null && now.isBefore(discount.getValidFrom())) throw new InvalidDiscountException();
+        if (discount.getValidTo() != null && now.isAfter(discount.getValidTo())) throw new InvalidDiscountException();
+        if (discount.getMinOrderAmount() != null && subtotal.compareTo(discount.getMinOrderAmount()) < 0) {
+            throw new InvalidDiscountException();
+        }
+        return new Applied(discount.getCode(), amountFor(discount, subtotal));
+    }
+
+    /** The discount amount for {@code subtotal} (scale 2, never above the subtotal, never negative). Pure. */
+    static BigDecimal amountFor(Discount discount, BigDecimal subtotal) {
+        BigDecimal raw;
+        if (discount.getPercentOff() != null) {
+            // whole VND, HALF_UP: 15% of 99,990 = 14,998.5 -> 14,999
+            raw = subtotal.multiply(BigDecimal.valueOf(discount.getPercentOff()))
+                    .divide(BigDecimal.valueOf(100), 0, RoundingMode.HALF_UP);
+        } else if (discount.getAmountOff() != null) {
+            raw = discount.getAmountOff();
+        } else {
+            raw = BigDecimal.ZERO; // a malformed row (the CHECK in V40 prevents it) takes nothing off
+        }
+        return raw.min(subtotal).max(BigDecimal.ZERO).setScale(2, RoundingMode.HALF_UP);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Admin CRUD
+    // ------------------------------------------------------------------------------------------------------------
+
+    @Transactional(readOnly = true)
+    public Page<Discount> list(String keyword, Boolean active, Pageable pageable) {
+        return discountRepository.search(likePattern(keyword), active != null, Boolean.TRUE.equals(active), pageable);
+    }
+
+    @Transactional(readOnly = true)
+    public Discount get(Long id) {
+        return discountRepository.findById(id)
+                .orElseThrow(() -> new ResourceNotFoundException("Không tìm thấy mã giảm giá #" + id));
+    }
+
+    @Transactional
+    public Discount create(DiscountRequest request) {
+        String code = normalize(request.code());
+        if (code == null) throw new BadRequestException("Mã giảm giá là bắt buộc.");
+        validateShape(request);
+        if (discountRepository.existsByCode(code)) throw new ConflictException("Mã giảm giá đã tồn tại.");
+        Discount discount = new Discount();
+        apply(discount, code, request);
+        return discountRepository.save(discount);
+    }
+
+    @Transactional
+    public Discount update(Long id, DiscountRequest request) {
+        Discount discount = get(id);
+        String code = normalize(request.code());
+        if (code == null) throw new BadRequestException("Mã giảm giá là bắt buộc.");
+        validateShape(request);
+        if (discountRepository.existsByCodeAndIdNot(code, id)) throw new ConflictException("Mã giảm giá đã tồn tại.");
+        apply(discount, code, request);
+        return discountRepository.save(discount);
+    }
+
+    /** Hard delete is safe: orders keep their own text copy of the code and the amount applied. */
+    @Transactional
+    public void delete(Long id) {
+        discountRepository.delete(get(id));
+    }
+
+    private static void validateShape(DiscountRequest r) {
+        if ((r.percentOff() == null) == (r.amountOff() == null)) {
+            throw new BadRequestException("Chỉ nhập một trong hai: phần trăm giảm hoặc số tiền giảm.");
+        }
+        if (r.validFrom() != null && r.validTo() != null && r.validFrom().isAfter(r.validTo())) {
+            throw new BadRequestException("Ngày bắt đầu phải trước hoặc bằng ngày kết thúc.");
+        }
+    }
+
+    private static void apply(Discount d, String code, DiscountRequest r) {
+        d.setCode(code);
+        d.setPercentOff(r.percentOff());
+        d.setAmountOff(r.amountOff() == null ? null : r.amountOff().setScale(2, RoundingMode.HALF_UP));
+        d.setMinOrderAmount(r.minOrderAmount() == null ? null : r.minOrderAmount().setScale(2, RoundingMode.HALF_UP));
+        d.setValidFrom(r.validFrom());
+        d.setValidTo(r.validTo());
+        d.setActive(r.active() == null || r.active());
+    }
+
+    /** Upper-case, trimmed; null for null / blank. */
+    static String normalize(String code) {
+        if (code == null || code.isBlank()) return null;
+        return code.trim().toUpperCase(Locale.ROOT);
+    }
+
+    /** Lower-cased LIKE pattern with {@code % _ !} escaped (escape char {@code !}); "%" when there is no keyword. */
+    static String likePattern(String keyword) {
+        if (keyword == null || keyword.isBlank()) return "%";
+        String escaped = keyword.trim().toLowerCase(Locale.ROOT).replace("!", "!!").replace("%", "!%").replace("_", "!_");
+        return "%" + escaped + "%";
+    }
+}

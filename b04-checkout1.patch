diff --git a/backend/src/main/resources/db/migration/V40__discounts.sql b/backend/src/main/resources/db/migration/V40__discounts.sql
new file mode 100644
index 0000000..7c2a98b
--- /dev/null
+++ b/backend/src/main/resources/db/migration/V40__discounts.sql
@@ -0,0 +1,70 @@
+-- B04: discount codes (validated server-side at checkout preview and checkout; managed through /api/v1/admin/discounts).
+--
+-- LEGACY DATA IMPACT:        None. New table; no existing table or row is changed. Historical orders keep their stored
+--                            discount_code TEXT and discount_amount (V22); there is deliberately NO foreign key from orders to
+--                            discounts, so deleting or editing a code never changes an order that already used it.
+-- NULLABILITY:               New table, nothing to backfill. code, active, created_at are NOT NULL. percent_off, amount_off,
+--                            min_order_amount, valid_from, valid_to are nullable (a code without dates never expires; without
+--                            min_order_amount it has no minimum).
+-- CONSTRAINT ORDER:          (1) create the table with its CHECKs, (2) create the unique index on upper(code). Nothing is
+--                            inserted, so no data can violate a constraint.
+-- DATA-LOSS / ROLLBACK RISK: Dropping the table loses every code the admins created (orders keep their text copy).
+--                            Manual rollback:  DROP TABLE IF EXISTS discounts;
+-- EMPTY DATABASE:            Fine - creates the empty table.
+-- EXISTING DATABASE:         Fine and idempotent - IF NOT EXISTS everywhere. If the application already ran with ddl-auto=update,
+--                            Hibernate created the table WITHOUT the CHECK constraints and WITHOUT the upper(code) index (the
+--                            entity cannot express them); this script adds both when missing. Adding a CHECK fails if existing
+--                            rows violate it - see the verification queries.
+--
+-- NOT EXECUTED: this file is applied by hand with psql (Flyway is not active); the application does not need it to start, but
+-- without it the database does not enforce "exactly one of percent_off / amount_off" nor case-insensitive uniqueness of codes.
+--
+-- INDEXES (each is backed by a real query):
+--   uq_discounts_code_upper  UNIQUE (upper(code))  <- DiscountRepository.findByCode / existsByCode (codes are stored upper-case and
+--                                                     matched case-insensitively) and the duplicate-code guard
+--   the admin list is a tiny table; it uses a sequential scan on purpose (no extra index).
+--
+-- VERIFICATION (read-only):
+--   -- expected columns (expect 9 rows)
+--   SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_name = 'discounts' ORDER BY ordinal_position;
+--   -- expected constraints (expect pkey + chk_discounts_percent_range + chk_discounts_amount_positive + chk_discounts_exactly_one)
+--   SELECT conname, contype FROM pg_constraint WHERE conrelid = 'discounts'::regclass ORDER BY conname;
+--   -- expected index (expect 1 row, indexdef contains upper((code)::text))
+--   SELECT indexdef FROM pg_indexes WHERE indexname = 'uq_discounts_code_upper';
+--   -- BEFORE applying on a database that already has rows: rows that would violate the rules (expect 0 rows each)
+--   SELECT id, code FROM discounts WHERE (percent_off IS NULL) = (amount_off IS NULL);
+--   SELECT upper(code), count(*) FROM discounts GROUP BY upper(code) HAVING count(*) > 1;
+
+CREATE TABLE IF NOT EXISTS discounts (
+    id               BIGSERIAL     PRIMARY KEY,
+    code             VARCHAR(30)   NOT NULL,
+    percent_off      SMALLINT,
+    amount_off       DECIMAL(12,2),
+    min_order_amount DECIMAL(12,2),
+    valid_from       TIMESTAMP,
+    valid_to         TIMESTAMP,
+    active           BOOLEAN       NOT NULL DEFAULT true,
+    created_at       TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+-- A table created earlier by ddl-auto=update has no defaults; make both paths identical.
+ALTER TABLE discounts ALTER COLUMN active SET DEFAULT true;
+ALTER TABLE discounts ALTER COLUMN created_at SET DEFAULT CURRENT_TIMESTAMP;
+
+DO $$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_discounts_percent_range' AND conrelid = 'discounts'::regclass) THEN
+        ALTER TABLE discounts ADD CONSTRAINT chk_discounts_percent_range
+            CHECK (percent_off IS NULL OR (percent_off BETWEEN 1 AND 100));
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_discounts_amount_positive' AND conrelid = 'discounts'::regclass) THEN
+        ALTER TABLE discounts ADD CONSTRAINT chk_discounts_amount_positive
+            CHECK (amount_off IS NULL OR amount_off > 0);
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'chk_discounts_exactly_one' AND conrelid = 'discounts'::regclass) THEN
+        ALTER TABLE discounts ADD CONSTRAINT chk_discounts_exactly_one
+            CHECK ((percent_off IS NULL) <> (amount_off IS NULL));
+    END IF;
+END $$;
+
+CREATE UNIQUE INDEX IF NOT EXISTS uq_discounts_code_upper ON discounts (upper(code));
diff --git a/backend/src/main/resources/db/migration/V41__discount_permissions.sql b/backend/src/main/resources/db/migration/V41__discount_permissions.sql
new file mode 100644
index 0000000..504c768
--- /dev/null
+++ b/backend/src/main/resources/db/migration/V41__discount_permissions.sql
@@ -0,0 +1,34 @@
+-- B04: permissions for the discount admin API (discount:view, discount:manage) and their role mapping.
+--
+-- LEGACY DATA IMPACT:        Inserts two catalogue rows and role_permissions rows only; no existing row is changed or deleted.
+--                            After this script ADMIN holds all 29 permissions and MANAGER 26 (everything except system:configure,
+--                            audit:view, user:disable - owner decision D-6), CUSTOMER none. Users receive them in their NEXT access
+--                            token (existing tokens keep their old claims for up to 15 minutes).
+-- NULLABILITY:               permissions.description is filled for both rows; no column is added.
+-- CONSTRAINT ORDER:          permissions -> role_permissions (the foreign keys are satisfied in that order).
+-- DATA-LOSS / ROLLBACK RISK: None on apply. Re-running only ADDS missing rows. Manual rollback:
+--                              DELETE FROM role_permissions WHERE permission_id IN (SELECT id FROM permissions WHERE code LIKE 'discount:%');
+--                              DELETE FROM permissions WHERE code LIKE 'discount:%';
+-- EMPTY DATABASE:            Yes - apply after V4, V5, V6 (and V40 is independent of this file).
+-- EXISTING DATABASE:         Yes - idempotent (ON CONFLICT DO NOTHING everywhere).
+-- Manual application order: V4 -> V5 -> V6 -> V41 (Flyway is not active).
+-- The Java source of truth is security/Permissions.java; PermissionsCatalogueTest fails if V6 + V41 drift from it.
+--
+-- NOT EXECUTED: applied by hand with psql.
+--
+-- VERIFICATION (read-only):
+--   -- expect 2 rows
+--   SELECT code FROM permissions WHERE code LIKE 'discount:%' ORDER BY code;
+--   -- expect ADMIN 2 and MANAGER 2 rows, CUSTOMER absent
+--   SELECT r.name, count(*) FROM role_permissions rp JOIN roles r ON r.id = rp.role_id
+--     JOIN permissions p ON p.id = rp.permission_id WHERE p.code LIKE 'discount:%' GROUP BY r.name ORDER BY r.name;
+
+INSERT INTO permissions (code, description) VALUES
+    ('discount:view', 'View discount codes'),
+    ('discount:manage', 'Create, update and delete discount codes')
+ON CONFLICT (code) DO NOTHING;
+
+INSERT INTO role_permissions (role_id, permission_id)
+SELECT r.id, p.id FROM roles r CROSS JOIN permissions p
+WHERE r.name IN ('ADMIN', 'MANAGER') AND p.code IN ('discount:view', 'discount:manage')
+ON CONFLICT DO NOTHING;

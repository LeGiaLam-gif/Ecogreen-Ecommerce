+        verify(orderService).createPendingOrder(eq(USER), any(), amounts.capture(), amounts.capture(), amounts.capture(),
+                amounts.capture(), eq("An"), eq("0900000000"), eq("1 Lê Lợi"), isNull());
+        // subtotal 250 000 (below 500 000) + flat shipping 30 000, no discount
+        assertEquals(List.of(new BigDecimal("250000.00"), new BigDecimal("0.00"), new BigDecimal("30000.00"),

+
+    // ── ownership ───────────────────────────────────────────────────────────────
+
+    @Test
+    void cart_itemOwnership_enforced() {
+        // Item 10 belongs to USER; the query that includes the caller's id finds nothing for the intruder.
+        when(cartItems.findOwnedWithProduct(10L, INTRUDER)).thenReturn(Optional.empty());

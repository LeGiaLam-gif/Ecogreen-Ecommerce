@@ -0,0 +1,68 @@
+package com.example.backend.service;
+
+import com.example.backend.entity.Order;
+import com.example.backend.entity.Payment;
+import com.example.backend.exception.BadRequestException;
+import com.example.backend.repository.PaymentRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.math.BigDecimal;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/** B04: the minimal first payment row created by checkout (amount = the ORDER total, status PENDING, validated method). */
+class PaymentServiceCreatePendingTest {
+
+    private PaymentRepository payments;
+    private PaymentService service;
+    private Order order;
+
+    @BeforeEach
+    void setUp() {
+        payments = mock(PaymentRepository.class);
+        service = new PaymentService();
+        ReflectionTestUtils.setField(service, "paymentRepository", payments);
+        when(payments.save(any(Payment.class))).thenAnswer(inv -> inv.getArgument(0));
+        order = new Order();
+        order.setId(100L);
+        order.setTotalPrice(new BigDecimal("280000.00"));
+    }
+
+    @Test
+    void createPendingPayment_usesTheOrderTotal_pending_andNoTransactionId() {
+        Payment payment = service.createPendingPayment(order, "vietqr");
+
+        ArgumentCaptor<Payment> saved = ArgumentCaptor.forClass(Payment.class);
+        verify(payments).save(saved.capture());
+        assertEquals(payment, saved.getValue());
+        assertEquals("VIETQR", payment.getPaymentMethod());
+        assertEquals(new BigDecimal("280000.00"), payment.getAmount());
+        assertEquals(Payment.Status.PENDING, payment.getStatus());
+        assertEquals(order, payment.getOrder());
+        assertEquals(null, payment.getTransactionId());
+    }
+
+    @Test
+    void createPendingPayment_acceptsCodVietqrMomo_inAnyCase() {
+        for (String method : new String[] {"COD", "cod", " Momo ", "VIETQR"}) {
+            service.createPendingPayment(order, method);
+        }
+    }
+
+    @Test
+    void createPendingPayment_unknownOrMissingMethod_isRejected_andNothingIsSaved() {
+        assertThrows(BadRequestException.class, () -> service.createPendingPayment(order, "BITCOIN"));
+        assertThrows(BadRequestException.class, () -> service.createPendingPayment(order, ""));
+        assertThrows(BadRequestException.class, () -> service.createPendingPayment(order, null));
+        verify(payments, never()).save(any());
+    }
+}

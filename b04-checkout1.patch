+        mvc.perform(as(put("/api/v1/admin/discounts/3").contentType(JSON).content(BODY), Permissions.DISCOUNT_MANAGE))
+                .andExpect(status().isOk());
+        mvc.perform(as(delete("/api/v1/admin/discounts/3"), Permissions.DISCOUNT_MANAGE)).andExpect(status().isNoContent());

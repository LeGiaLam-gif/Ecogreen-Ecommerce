+package com.example.backend.db;
+
+import com.example.backend.dto.CartResponse;
+import com.example.backend.dto.CheckoutRequest;
+import com.example.backend.entity.Category;
+import com.example.backend.entity.Product;
+import com.example.backend.entity.Role;
+import com.example.backend.entity.User;
+import com.example.backend.exception.BusinessRuleViolationException;
+import com.example.backend.repository.CartItemRepository;
+import com.example.backend.repository.CartRepository;
+import com.example.backend.repository.CategoryRepository;
+import com.example.backend.repository.InventoryRepository;
+import com.example.backend.repository.OrderRepository;
+import com.example.backend.repository.ProductRepository;
+import com.example.backend.repository.RoleRepository;
+import com.example.backend.repository.UserRepository;
+import com.example.backend.service.CartService;
+import com.example.backend.service.CheckoutService;
+import com.example.backend.service.inventory.InsufficientStockException;
+import com.example.backend.service.inventory.InventoryService;
+import jakarta.persistence.EntityManager;
+import jakarta.persistence.EntityManagerFactory;
+import jakarta.persistence.PersistenceContext;
+import org.hibernate.SessionFactory;
+import org.hibernate.stat.Statistics;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.DynamicPropertyRegistry;
+import org.springframework.test.context.DynamicPropertySource;
+import org.springframework.test.context.TestPropertySource;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.support.TransactionTemplate;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * B04 against a REAL PostgreSQL with the REAL Spring context: the cart row lock (two simultaneous checkouts of one cart create
+ * ONE order), the real rollback (a failed checkout leaves no order, no reservation and the cart intact) and the SQL statement
+ * counts of reading the cart. Needs ECOGREEN_TEST_PG_URL (optional ECOGREEN_TEST_PG_USER / ECOGREEN_TEST_PG_PASSWORD);
+ * otherwise skipped = NOT RUN. Same warning as CustomerPostgresTest: scratch database only (ddl-auto=update, rows are inserted
+ * under a random tag and removed best-effort afterwards). V22/V30/V31/V40 should be applied for a faithful run.
+ */
+@SpringBootTest
+@TestPropertySource(locations = "classpath:test-jwt.properties")
+@EnabledIfEnvironmentVariable(named = "ECOGREEN_TEST_PG_URL", matches = ".+")
+class CheckoutPostgresTest {
+
+    @DynamicPropertySource
+    static void database(DynamicPropertyRegistry registry) {
+        String url = System.getenv("ECOGREEN_TEST_PG_URL");
+        if (url == null || url.isBlank()) return;
+        registry.add("spring.datasource.url", () -> url);
+        registry.add("spring.datasource.username", () -> System.getenv().getOrDefault("ECOGREEN_TEST_PG_USER", "postgres"));
+        registry.add("spring.datasource.password", () -> System.getenv().getOrDefault("ECOGREEN_TEST_PG_PASSWORD", ""));
+        registry.add("spring.jpa.hibernate.ddl-auto", () -> "update");
+    }
+
+    @Autowired private CheckoutService checkoutService;
+    @Autowired private CartService cartService;
+    @Autowired private InventoryService inventoryService;
+    @Autowired private UserRepository userRepository;
+    @Autowired private RoleRepository roleRepository;
+    @Autowired private CategoryRepository categoryRepository;
+    @Autowired private ProductRepository productRepository;
+    @Autowired private CartRepository cartRepository;
+    @Autowired private CartItemRepository cartItemRepository;
+    @Autowired private OrderRepository orderRepository;
+    @Autowired private InventoryRepository inventoryRepository;
+    @Autowired private EntityManagerFactory entityManagerFactory;
+    @Autowired private PlatformTransactionManager transactionManager;
+    @PersistenceContext private EntityManager em;
+
+    private final String tag = "b04" + UUID.randomUUID().toString().substring(0, 8);
+    private final List<Long> userIds = new ArrayList<>();
+    private final List<Long> productIds = new ArrayList<>();
+    private final List<Long> categoryIds = new ArrayList<>();
+
+    private TransactionTemplate tx() {
+        return new TransactionTemplate(transactionManager);
+    }
+
+    private User newUser(String suffix) {
+        return tx().execute(status -> {
+            User u = new User();
+            u.setUsername(tag + suffix);
+            u.setEmail(tag + suffix + "@example.test");
+            u.setPassword("$2a$10$testtesttesttesttesttesttesttesttesttesttesttesttest");
+            u.setActive(true);
+            u.setRoles(new HashSet<>(Set.of(roleRepository.findByName(Role.CUSTOMER).orElseThrow())));
+            User saved = userRepository.save(u);
+            userIds.add(saved.getId());
+            return saved;
+        });
+    }
+
+    private Category newCategory(String suffix) {
+        return tx().execute(status -> {
+            Category c = new Category();
+            c.setName(tag + "cat" + suffix);
+            c.setSlug(tag + "-cat-" + suffix);
+            Category saved = categoryRepository.save(c);
+            categoryIds.add(saved.getId());
+            return saved;
+        });
+    }
+
+    private Product newProduct(Category category, String suffix, String price, int stock) {
+        Product p = tx().execute(status -> {
+            Product product = new Product();
+            product.setName(tag + "p" + suffix);
+            product.setSlug(tag + "-p-" + suffix);
+            product.setPrice(new BigDecimal(price));
+            product.setStatus(Product.Status.ACTIVE);
+            product.setCategory(category);
+            Product saved = productRepository.save(product);
+            productIds.add(saved.getId());
+            return saved;
+        });
+        inventoryService.initialize(p.getId(), stock, null);
+        return p;
+    }
+
+    private static CheckoutRequest request() {
+        return new CheckoutRequest(null, "An", "0900000000", "1 Lê Lợi", null, "COD");
+    }
+
+    private int reserved(long productId) {
+        return inventoryRepository.findById(productId).orElseThrow().getReservedQuantity();
+    }
+
+    private long ordersOf(long userId) {
+        return tx().execute(status -> orderRepository.count((root, query, cb) -> cb.equal(root.get("userId"), userId)));
+    }
+
+    @AfterEach
+    void cleanUp() {
+        // best effort, in FK order; a failure here must not hide the result of the test
+        tx().executeWithoutResult(status -> {
+            for (Long uid : userIds) {
+                run("DELETE FROM payments WHERE order_id IN (SELECT id FROM orders WHERE user_id = " + uid + ")");
+                run("DELETE FROM order_status_history WHERE order_id IN (SELECT id FROM orders WHERE user_id = " + uid + ")");
+                run("DELETE FROM order_items WHERE order_id IN (SELECT id FROM orders WHERE user_id = " + uid + ")");
+                run("DELETE FROM orders WHERE user_id = " + uid);
+                run("DELETE FROM cart_items WHERE cart_id IN (SELECT id FROM carts WHERE user_id = " + uid + ")");
+                run("DELETE FROM carts WHERE user_id = " + uid);
+                run("DELETE FROM refresh_tokens WHERE user_id = " + uid);
+                run("DELETE FROM user_roles WHERE user_id = " + uid);
+                run("DELETE FROM users WHERE id = " + uid);
+            }
+            for (Long pid : productIds) {
+                run("DELETE FROM inventory_transactions WHERE product_id = " + pid);
+                run("DELETE FROM inventory WHERE product_id = " + pid);
+                run("DELETE FROM products WHERE id = " + pid);
+            }
+            for (Long cid : categoryIds) run("DELETE FROM categories WHERE id = " + cid);
+        });
+    }
+
+    private void run(String sql) {
+        try {
+            em.createNativeQuery(sql).executeUpdate();
+        } catch (RuntimeException ignored) {
+            // table or column absent in this scratch database: nothing to clean there
+        }
+    }
+
+    // ── happy path with real money, stock and cart ────────────────────────────
+
+    @Test
+    void checkout_realDatabase_placesOrder_reservesStock_createsPayment_andClearsTheCart() {
+        User user = newUser("a");
+        Category category = newCategory("a");
+        Product p1 = newProduct(category, "1", "100000", 5);
+        Product p2 = newProduct(category, "2", "50000", 5);
+        cartService.addItem(user.getId(), p1.getId(), 2);
+        cartService.addItem(user.getId(), p2.getId(), 1);
+
+        CheckoutService.PlacedOrder placed = checkoutService.checkout(user.getId(), request());
+
+        // subtotal 250 000 (< 500 000) + shipping 30 000 = 280 000
+        assertEquals(0, new BigDecimal("280000").compareTo(placed.order().getTotalPrice()));
+        assertEquals(2, placed.items().size());
+        assertEquals(2, reserved(p1.getId()));
+        assertEquals(1, reserved(p2.getId()));
+        assertEquals(1, ordersOf(user.getId()));
+        assertTrue(cartService.getCart(user.getId()).items.isEmpty(), "the cart is emptied by checkout");
+    }
+
+    // ── the cart row lock ─────────────────────────────────────────────────────
+
+    @Test
+    void checkout_concurrentSameCart_createsOneOrder() throws Exception {
+        User user = newUser("race");
+        Category category = newCategory("race");
+        Product p = newProduct(category, "r", "100000", 10);
+        cartService.addItem(user.getId(), p.getId(), 2);
+
+        int threads = 4;
+        CountDownLatch ready = new CountDownLatch(threads);
+        CountDownLatch go = new CountDownLatch(1);
+        ExecutorService pool = Executors.newFixedThreadPool(threads);
+        List<Future<Boolean>> results = new ArrayList<>();
+        for (int i = 0; i < threads; i++) {
+            Callable<Boolean> attempt = () -> {
+                ready.countDown();
+                go.await(10, TimeUnit.SECONDS);
+                try {
+                    checkoutService.checkout(user.getId(), request());
+                    return true;
+                } catch (BusinessRuleViolationException e) {
+                    return false; // the cart was already emptied by the winner: "giỏ hàng trống"
+                }
+            };
+            results.add(pool.submit(attempt));
+        }
+        ready.await(10, TimeUnit.SECONDS);
+        go.countDown();
+        int succeeded = 0;
+        for (Future<Boolean> f : results) if (f.get(30, TimeUnit.SECONDS)) succeeded++;
+        pool.shutdownNow();
+
+        assertEquals(1, succeeded, "exactly one checkout of the same cart may win");
+        assertEquals(1, ordersOf(user.getId()));
+        assertEquals(2, reserved(p.getId()), "stock is reserved once, not once per attempt");
+    }
+
+    // ── real rollback ─────────────────────────────────────────────────────────
+
+    @Test
+    void checkout_failure_leavesNoOrderNoReservation_andKeepsTheCart() {
+        User user = newUser("fail");
+        Category category = newCategory("fail");
+        Product p1 = newProduct(category, "f1", "100000", 5);
+        Product p2 = newProduct(category, "f2", "50000", 5);
+        cartService.addItem(user.getId(), p1.getId(), 2);
+        cartService.addItem(user.getId(), p2.getId(), 1);
+        // the second product becomes unavailable after it was put in the cart
+        inventoryService.setAvailable(p2.getId(), 0, "test", null);
+
+        org.junit.jupiter.api.Assertions.assertThrows(InsufficientStockException.class,
+                () -> checkoutService.checkout(user.getId(), request()));
+
+        assertEquals(0, ordersOf(user.getId()));
+        assertEquals(0, reserved(p1.getId()));
+        assertEquals(0, reserved(p2.getId()));
+        CartResponse cart = cartService.getCart(user.getId());
+        assertEquals(2, cart.items.size(), "the cart is untouched");
+        assertEquals(3, cart.totalItems);
+    }
+
+    // ── SQL statement counts ──────────────────────────────────────────────────
+
+    @Test
+    void cartRead_statementCount_doesNotGrowWithTheNumberOfItems() {
+        User small = newUser("s1");
+        User large = newUser("s2");
+        Category c1 = newCategory("s1");
+        Category c2 = newCategory("s2");
+        Category c3 = newCategory("s3");
+        Product a = newProduct(c1, "a", "1000", 9);
+        cartService.addItem(small.getId(), a.getId(), 1);
+        List<Product> many = new ArrayList<>();
+        Category[] categories = {c1, c2, c3};
+        for (int i = 0; i < 6; i++) many.add(newProduct(categories[i % 3], "m" + i, "1000", 9));
+        for (Product p : many) cartService.addItem(large.getId(), p.getId(), 1);
+
+        Statistics stats = entityManagerFactory.unwrap(SessionFactory.class).getStatistics();
+        stats.setStatisticsEnabled(true);
+        stats.clear();
+        cartService.getCart(small.getId());
+        long oneItem = stats.getPrepareStatementCount();
+        stats.clear();
+        cartService.getCart(large.getId());
+        long sixItems = stats.getPrepareStatementCount();
+
+        System.out.println("B04 cart read statements: 1 item = " + oneItem + ", 6 items in 3 categories = " + sixItems);
+        assertEquals(oneItem, sixItems, "reading the cart must not issue a query per item or per category");
+    }
+
+    @Test
+    void checkout_statementCounts_areReportedForOneAndThreeItems() {
+        User one = newUser("c1");
+        User three = newUser("c3");
+        Category category = newCategory("c");
+        Product a = newProduct(category, "ca", "1000", 99);
+        Product b = newProduct(category, "cb", "1000", 99);
+        Product c = newProduct(category, "cc", "1000", 99);
+        cartService.addItem(one.getId(), a.getId(), 1);
+        cartService.addItem(three.getId(), a.getId(), 1);
+        cartService.addItem(three.getId(), b.getId(), 1);
+        cartService.addItem(three.getId(), c.getId(), 1);
+
+        Statistics stats = entityManagerFactory.unwrap(SessionFactory.class).getStatistics();
+        stats.setStatisticsEnabled(true);
+        stats.clear();
+        checkoutService.checkout(one.getId(), request());
+        long oneItem = stats.getPrepareStatementCount();
+        stats.clear();
+        checkoutService.checkout(three.getId(), request());
+        long threeItems = stats.getPrepareStatementCount();
+
+        // Reporting only: each reserved item inherently costs its own locked inventory read, update and ledger row (B03).
+        System.out.println("B04 checkout statements: 1 item = " + oneItem + ", 3 items = " + threeItems);
+        assertTrue(threeItems > oneItem && threeItems - oneItem <= 3 * 6, "growth per extra item stays small and constant");
+    }
+}

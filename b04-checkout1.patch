@@ -0,0 +1,26 @@
+package com.example.backend.dto;
+
+import com.example.backend.entity.Product;
+
+/**
+ * B04: a problem with one cart line, with a customer-facing message produced by the SERVER (the cart page and the checkout
+ * page show these messages as they are). {@code code}: PRODUCT_UNAVAILABLE, OUT_OF_STOCK or INSUFFICIENT_STOCK.
+ */
+public record LineIssue(String code, String message) {
+
+    /** The issue of a line wanting {@code quantity} units while {@code available} are sellable, or null when it is fine. */
+    public static LineIssue check(Product product, int quantity, int available) {
+        String name = product.getName() == null ? "" : product.getName().trim();
+        String label = name.isEmpty() ? "Sản phẩm" : "Sản phẩm \"" + name + "\"";
+        if (product.getStatus() != Product.Status.ACTIVE) {
+            return new LineIssue("PRODUCT_UNAVAILABLE", label + " hiện không còn kinh doanh.");
+        }
+        if (available <= 0) {
+            return new LineIssue("OUT_OF_STOCK", label + " đã hết hàng.");
+        }
+        if (available < quantity) {
+            return new LineIssue("INSUFFICIENT_STOCK", label + " chỉ còn " + available + " sản phẩm trong kho.");
+        }
+        return null;
+    }
+}

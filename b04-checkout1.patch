+
+    @Test
+    void duplicateCode_is409Conflict_andUnknownId_is404() throws Exception {
+        when(service.create(any(DiscountRequest.class))).thenThrow(new ConflictException("Mã giảm giá đã tồn tại."));
+        doThrow(new ResourceNotFoundException("Không tìm thấy mã giảm giá #99")).when(service).delete(99L);
+
+        mvc.perform(as(post("/api/v1/admin/discounts").contentType(JSON).content(BODY), Permissions.DISCOUNT_MANAGE))

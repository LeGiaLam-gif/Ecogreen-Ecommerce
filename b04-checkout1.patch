+        created.setId(60L);
+        when(carts.save(any(Cart.class))).thenReturn(created);
+        when(cartItems.findByCartIdAndProductId(60L, 7L)).thenReturn(Optional.empty());
+        when(inventory.available(7L)).thenReturn(5);
+
+        service.addItem(9L, 7L, 1);
+
+        verify(carts).save(any(Cart.class));
+        verify(cartItems).save(any(CartItem.class));
+    }
+
+    @Test
+    void updateQuantity_moreThanAvailable_isRejected_andTheItemIsUnchanged() {
+        CartItem item = item(10L, product, 1);
+        when(cartItems.findOwnedWithProduct(10L, USER)).thenReturn(Optional.of(item));
+        when(inventory.available(7L)).thenReturn(1);
+
+        BadRequestException ex = assertThrows(BadRequestException.class, () -> service.updateQuantity(USER, 10L, 2));
+
+        assertEquals("Kho chỉ còn 1 sản phẩm.", ex.getMessage());
+        assertEquals(1, item.getQuantity());
+        verify(cartItems, never()).save(any());
+    }
+
+    @Test
+    void updateQuantity_withinAvailable_updatesTheItem() {
+        CartItem item = item(10L, product, 1);
+        when(cartItems.findOwnedWithProduct(10L, USER)).thenReturn(Optional.of(item));
+        when(inventory.available(7L)).thenReturn(4);

+        assertEquals(List.of(5, 2, 0, 9), cartResponse.items.stream().map(i -> i.availableQuantity).toList());
+        assertNull(cartResponse.items.get(0).warning);
+        assertEquals("Sản phẩm \"Bình nước\" chỉ còn 2 sản phẩm trong kho.", cartResponse.items.get(1).warning);
+        assertEquals("Sản phẩm \"Ống hút\" đã hết hàng.", cartResponse.items.get(2).warning);
+        assertEquals("Sản phẩm \"Cũ\" hiện không còn kinh doanh.", cartResponse.items.get(3).warning);
+        assertEquals(new BigDecimal("100000"), cartResponse.items.get(0).subtotal);
+        assertEquals(5, cartResponse.items.get(0).product.stockQuantity, "the product's stockQuantity is the same available value");
+    }
+
+    @Test
+    void getCart_readsItemsWithProductsInOneQuery_andAvailabilityInOneBatch() {
+        CartItem a = item(11L, product(1L, "A", "1000", Product.Status.ACTIVE), 1);
+        CartItem b = item(12L, product(2L, "B", "2000", Product.Status.ACTIVE), 1);
+        when(cartItems.findByCartIdWithProduct(50L)).thenReturn(List.of(a, b));
+        when(inventory.availableFor(List.of(1L, 2L))).thenReturn(Map.of(1L, 3, 2L, 3));
+
+        service.getCart(USER);
+
+        verify(cartItems, times(1)).findByCartIdWithProduct(50L);
+        verify(inventory, times(1)).availableFor(anyCollection());
+        verify(cartItems, never()).findById(anyLong());
+        verify(inventory, never()).available(anyLong()); // no per-item stock query
+    }
+
+    @Test
+    void getCart_emptyCart_makesNoInventoryQuery() {
+        CartResponse cartResponse = service.getCart(USER);
+
+        assertEquals(0, cartResponse.items.size());
+        assertEquals(BigDecimal.ZERO, cartResponse.totalPrice);
+        verify(inventory, never()).availableFor(anyCollection());
+    }
+
+    @Test
+    void clear_removesTheItemsOfTheCallersCart() {
+        service.clear(USER);
+
+        verify(cartItems).deleteAllByCartId(50L);
+    }
+
+    @Test
+    void clear_userWithoutACart_isANoOp() {
+        when(carts.findByUserId(9L)).thenReturn(Optional.empty());
+
+        service.clear(9L);
+
+        verify(cartItems, never()).deleteAllByCartId(anyLong());
+    }
+
+    @Test
+    void availabilityFor_isOneBatchedInventoryCall() {
+        CartItem a = item(1L, product(7L, "A", "1", Product.Status.ACTIVE), 1);
+        CartItem b = item(2L, product(8L, "B", "1", Product.Status.ACTIVE), 1);
+        when(inventory.availableFor(List.of(7L, 8L))).thenReturn(Map.of(7L, 2, 8L, 0));
+
+        assertEquals(Map.of(7L, 2, 8L, 0), service.availabilityFor(List.of(a, b)));
+        verify(inventory, times(1)).availableFor(anyCollection());
+    }
+
+    @Test
+    void authServiceContract_createAndGetOrCreateForAUser_stillExist() {
+        User u = new User();
+        u.setId(USER);
+        Cart saved = new Cart();
+        when(carts.save(any(Cart.class))).thenReturn(saved);
+        when(carts.findByUserId(77L)).thenReturn(Optional.empty());
+        User u77 = new User();
+        u77.setId(77L);
+
+        assertEquals(cart, service.getOrCreateCart(u));
+        assertEquals(saved, service.createCartForUser(u));
+        assertEquals(saved, service.getOrCreateCart(u77));
+    }
+}

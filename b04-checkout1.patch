+package com.example.backend.repository;
+
+import com.example.backend.entity.Discount;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+import java.util.Optional;
+
+public interface DiscountRepository extends JpaRepository<Discount, Long> {
+
+    /** {@code code} must already be upper-case (codes are stored upper-case). Uses uq_discounts_code_upper when V40 is applied. */
+    @Query("SELECT d FROM Discount d WHERE upper(d.code) = :code")
+    Optional<Discount> findByCode(@Param("code") String code);
+
+    @Query("SELECT count(d) > 0 FROM Discount d WHERE upper(d.code) = :code")
+    boolean existsByCode(@Param("code") String code);
+
+    @Query("SELECT count(d) > 0 FROM Discount d WHERE upper(d.code) = :code AND d.id <> :id")
+    boolean existsByCodeAndIdNot(@Param("code") String code, @Param("id") Long id);
+
+    /**
+     * Admin list. {@code pattern} is a lower-cased LIKE pattern that is never null ("%" = no filter) and
+     * {@code filterActive} switches the optional filter on, so no parameter is ever null (PostgreSQL cannot infer the type of a
+     * null parameter).
+     */
+    @Query(value = "SELECT d FROM Discount d WHERE lower(d.code) LIKE :pattern ESCAPE '!' "
+            + "AND (:filterActive = false OR d.active = :active)",
+            countQuery = "SELECT count(d) FROM Discount d WHERE lower(d.code) LIKE :pattern ESCAPE '!' "
+            + "AND (:filterActive = false OR d.active = :active)")
+    Page<Discount> search(@Param("pattern") String pattern, @Param("filterActive") boolean filterActive,
+                          @Param("active") boolean active, Pageable pageable);
+}

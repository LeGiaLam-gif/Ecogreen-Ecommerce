new file mode 100644
index 0000000..8548ef8
--- /dev/null
+++ b/backend/src/test/java/com/example/backend/service/OrderPlacedEventAfterCommitTest.java
@@ -0,0 +1,106 @@
+package com.example.backend.service;
+
+import com.example.backend.event.OrderPlacedEvent;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.context.annotation.AnnotationConfigApplicationContext;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.transaction.PlatformTransactionManager;
+import org.springframework.transaction.TransactionDefinition;
+import org.springframework.transaction.annotation.EnableTransactionManagement;
+import org.springframework.transaction.event.TransactionPhase;
+import org.springframework.transaction.event.TransactionalEventListener;
+import org.springframework.transaction.support.AbstractPlatformTransactionManager;
+import org.springframework.transaction.support.DefaultTransactionStatus;
+import org.springframework.transaction.support.TransactionTemplate;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * B04: {@link OrderPlacedEvent} is meant for {@code @TransactionalEventListener(phase = AFTER_COMMIT)} consumers (B09 / B10).
+ * This proves, with REAL Spring transaction synchronisation and a no-op transaction manager (no database), what such a consumer
+ * sees: nothing while the transaction is open, the event after commit, and nothing at all when the transaction rolls back
+ * (CheckoutService publishes inside its transaction; a rolled-back checkout therefore announces no order).
+ */
+class OrderPlacedEventAfterCommitTest {
+
+    public static class Listener {
+        final List<OrderPlacedEvent> received = new CopyOnWriteArrayList<>();
+
+        @TransactionalEventListener(phase = TransactionPhase.AFTER_COMMIT)
+        public void onOrderPlaced(OrderPlacedEvent event) {
+            received.add(event);
+        }
+    }
+
+    /** Commits and rolls back nothing; only the synchronisation callbacks matter. */
+    static class NoopTransactionManager extends AbstractPlatformTransactionManager {
+        @Override protected Object doGetTransaction() { return new Object(); }
+        @Override protected void doBegin(Object transaction, TransactionDefinition definition) { }
+        @Override protected void doCommit(DefaultTransactionStatus status) { }
+        @Override protected void doRollback(DefaultTransactionStatus status) { }
+    }
+
+    @Configuration
+    @EnableTransactionManagement
+    static class Config {
+        @Bean PlatformTransactionManager transactionManager() { return new NoopTransactionManager(); }
+        @Bean Listener listener() { return new Listener(); }
+    }
+
+    private AnnotationConfigApplicationContext context;
+    private Listener listener;
+    private TransactionTemplate tx;
+
+    @BeforeEach
+    void setUp() {
+        context = new AnnotationConfigApplicationContext(Config.class);
+        listener = context.getBean(Listener.class);
+        tx = new TransactionTemplate(context.getBean(PlatformTransactionManager.class));
+    }
+
+    @AfterEach
+    void tearDown() {
+        context.close();
+    }
+
+    private final OrderPlacedEvent event = new OrderPlacedEvent(100L, 5L, new BigDecimal("280000.00"));
+
+    @Test
+    void checkout_publishesOrderPlacedEventAfterCommit() {
+        tx.executeWithoutResult(status -> {
+            context.publishEvent(event);
+            assertTrue(listener.received.isEmpty(), "nothing is delivered while the transaction is still open");
+        });
+
+        assertEquals(List.of(event), listener.received);
+    }
+
+    @Test
+    void rolledBackTransaction_announcesNothing() {
+        tx.executeWithoutResult(status -> {
+            context.publishEvent(event);
+            status.setRollbackOnly();
+        });
+
+        assertTrue(listener.received.isEmpty());
+    }
+
+    @Test
+    void failingTransaction_announcesNothing() {
+        assertThrows(IllegalStateException.class, () -> tx.executeWithoutResult(status -> {
+            context.publishEvent(event);
+            throw new IllegalStateException("InsufficientStock-like failure after the publish");
+        }));
+
+        assertTrue(listener.received.isEmpty());
+    }
+}

+        assertThrows(ResourceNotFoundException.class, () -> service.updateQuantity(INTRUDER, 10L, 2));
+        assertThrows(ResourceNotFoundException.class, () -> service.removeItem(INTRUDER, 10L));
+
+        verify(cartItems).findOwnedWithProduct(10L, INTRUDER); // the CALLER's id from the token is what is checked
+        verify(cartItems, never()).save(any());
+        verify(cartItems, never()).delete(any());
+        verify(cartItems, never()).findById(anyLong());
+    }
+
+    @Test
+    void cart_itemOwnership_theOwnerCanRemoveTheItem() {
+        CartItem item = item(10L, product, 1);
+        when(cartItems.findOwnedWithProduct(10L, USER)).thenReturn(Optional.of(item));
+
+        CartResponse cartResponse = service.removeItem(USER, 10L);
+
+        verify(cartItems).delete(item);
+        assertEquals(0, cartResponse.totalItems);
+    }
+
+    // ── response shape ──────────────────────────────────────────────────────────
+
+    @Test
+    void cart_response_includesAvailableQuantity() {
+        Product p1 = product(1L, "Hộp cơm", "50000", Product.Status.ACTIVE);
+        Product p2 = product(2L, "Bình nước", "100000", Product.Status.ACTIVE);
+        Product p3 = product(3L, "Ống hút", "5000", Product.Status.ACTIVE);

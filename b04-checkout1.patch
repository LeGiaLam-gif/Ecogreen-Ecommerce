+/** B04 cart rules on mocks: availability, ownership (a foreign item looks missing), and the shape of the cart response. */
+class CartServiceTest {
+
+    private static final long USER = 1L;
+    private static final long INTRUDER = 2L;
+
+    private CartRepository carts;
+    private CartItemRepository cartItems;
+    private ProductService productService;
+    private InventoryService inventory;
+    private UserRepository users;
+    private CartService service;
+    private Cart cart;
+    private Product product;
+
+    @BeforeEach
+    void setUp() {
+        carts = mock(CartRepository.class);
+        cartItems = mock(CartItemRepository.class);
+        productService = mock(ProductService.class);
+        inventory = mock(InventoryService.class);
+        users = mock(UserRepository.class);
+        service = new CartService();
+        ReflectionTestUtils.setField(service, "cartRepository", carts);
+        ReflectionTestUtils.setField(service, "cartItemRepository", cartItems);
+        ReflectionTestUtils.setField(service, "productService", productService);
+        ReflectionTestUtils.setField(service, "inventoryService", inventory);
+        ReflectionTestUtils.setField(service, "userRepository", users);
+
+        User user = new User();
+        user.setId(USER);
+        cart = new Cart();
+        cart.setId(50L);
+        cart.setUser(user);
+        product = product(7L, "Bình nước", "100000", Product.Status.ACTIVE);
+        ReflectionTestUtils.setField(product, "stockQuantity", 99); // frozen value: must be ignored
+
+        when(carts.findByUserId(USER)).thenReturn(Optional.of(cart));
+        when(productService.getById(7L)).thenReturn(product);
+        when(cartItems.findByCartIdAndProductId(50L, 7L)).thenReturn(Optional.empty());
+        when(cartItems.findByCartIdWithProduct(50L)).thenReturn(List.of());
+    }
+
+    private static Product product(long id, String name, String price, Product.Status status) {
+        Product p = new Product();
+        p.setId(id);
+        p.setName(name);
+        p.setPrice(new BigDecimal(price));
+        p.setStatus(status);
+        return p;
+    }
+
+    private CartItem item(long id, Product p, int quantity) {
+        CartItem item = new CartItem();
+        item.setId(id);
+        item.setCart(cart);
+        item.setProduct(p);
+        item.setQuantity(quantity);
+        return item;
+    }
+
+    // ── add / update: availability ─────────────────────────────────────────────
+
+    @Test
+    void addItem_moreThanAvailable_isRejectedWithTheAvailableCount_notTheFrozenOne() {
+        when(inventory.available(7L)).thenReturn(2);
+
+        BadRequestException ex = assertThrows(BadRequestException.class, () -> service.addItem(USER, 7L, 3));
+
+        assertEquals("Kho chỉ còn 2 sản phẩm.", ex.getMessage());
+        verify(cartItems, never()).save(any());
+    }
+
+    @Test
+    void addItem_withinAvailable_savesTheItem_andAnswersWithTheWholeCart() {
+        when(inventory.available(7L)).thenReturn(5);
+        when(cartItems.findByCartIdWithProduct(50L)).thenReturn(List.of(item(10L, product, 3)));
+        when(inventory.availableFor(anyCollection())).thenReturn(Map.of(7L, 5));
+
+        CartResponse cartResponse = service.addItem(USER, 7L, 3);
+
+        verify(cartItems).save(any(CartItem.class));
+        assertEquals(50L, cartResponse.cartId);
+        assertEquals(3, cartResponse.totalItems);
+        assertEquals(new BigDecimal("300000"), cartResponse.totalPrice);
+    }
+
+    @Test
+    void addItem_countsWhatTheCartAlreadyHolds() {
+        when(cartItems.findByCartIdAndProductId(50L, 7L)).thenReturn(Optional.of(item(10L, product, 2)));
+        when(inventory.available(7L)).thenReturn(3);
+
+        assertThrows(BadRequestException.class, () -> service.addItem(USER, 7L, 2)); // 2 + 2 > 3
+        verify(cartItems, never()).save(any());
+    }
+
+    @Test
+    void addItem_inactiveProduct_isRejected() {
+        when(productService.getById(8L)).thenReturn(product(8L, "Cũ", "1000", Product.Status.INACTIVE));
+
+        assertThrows(BadRequestException.class, () -> service.addItem(USER, 8L, 1));
+        verify(cartItems, never()).save(any());
+    }
+
+    @Test
+    void addItem_nonPositiveQuantity_isRejected() {
+        assertThrows(BadRequestException.class, () -> service.addItem(USER, 7L, 0));
+        assertThrows(BadRequestException.class, () -> service.addItem(USER, 7L, -1));
+        verifyNoInteractions(productService);
+    }
+
+    @Test
+    void addItem_userWithoutACart_getsOne() {
+        when(carts.findByUserId(9L)).thenReturn(Optional.empty());

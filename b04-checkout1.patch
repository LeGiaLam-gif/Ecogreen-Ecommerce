+        mvc.perform(as(get("/api/v1/admin/discounts"))).andExpect(status().isForbidden()).andExpect(jsonPath("$.error.code").value("FORBIDDEN"));
+        mvc.perform(as(get("/api/v1/admin/discounts/3"), Permissions.PRODUCT_VIEW)).andExpect(status().isForbidden());

diff --git a/backend/src/main/java/com/example/backend/service/CheckoutService.java b/backend/src/main/java/com/example/backend/service/CheckoutService.java
new file mode 100644
index 0000000..8dcd091
--- /dev/null
+++ b/backend/src/main/java/com/example/backend/service/CheckoutService.java
@@ -0,0 +1,270 @@
+package com.example.backend.service;
+
+import com.example.backend.dto.CheckoutPreviewResponse;
+import com.example.backend.dto.CheckoutRequest;
+import com.example.backend.dto.LineIssue;
+import com.example.backend.entity.Address;
+import com.example.backend.entity.Cart;
+import com.example.backend.entity.CartItem;
+import com.example.backend.entity.Order;
+import com.example.backend.entity.OrderItem;
+import com.example.backend.entity.Product;
+import com.example.backend.event.OrderPlacedEvent;
+import com.example.backend.exception.BadRequestException;
+import com.example.backend.exception.BusinessRuleViolationException;
+import com.example.backend.repository.CartItemRepository;
+import com.example.backend.repository.CartRepository;
+import com.example.backend.repository.OrderItemRepository;
+import com.example.backend.service.inventory.InsufficientStockException;
+import com.example.backend.service.inventory.InventoryGateway;
+import com.example.backend.service.inventory.InventoryService;
+import jakarta.annotation.PostConstruct;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.ApplicationEventPublisher;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDateTime;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * B04: turns the caller's cart into a PENDING_PAYMENT order, and previews that with the very same pricing code.
+ *
+ * <p>{@link #checkout} is ONE transaction, in this order (the order matters, see the numbers in the code):
+ * lock the cart row, load items with products, validate each line, subtotal, discount, shipping, total, create the pending
+ * order with the address snapshot, reserve stock in ascending product id, create the pending payment, clear the cart LAST.
+ * Any failure (for example {@link InsufficientStockException} on the second item) rolls back everything, so the order, the
+ * reservations, the payment and the cart clearing all disappear together and the cart stays as it was.
+ *
+ * <p>Concurrency: the cart row lock makes a second checkout of the same cart wait; after the first commits it reads an empty cart
+ * and is rejected with 400, so one cart produces one order. Money never comes from the client.
+ *
+ * <p>Shipping (owner decision D-10): {@code ecogreen.shipping.flat-fee} is charged unless the goods amount after discount
+ * ({@code subtotal - discount}) is at least {@code ecogreen.shipping.free-threshold} (exactly the threshold is free).
+ */
+@Service
+public class CheckoutService {
+
+    static final String INVENTORY_REF_TYPE = "ORDER";
+    static final String EMPTY_CART = "Giỏ hàng của bạn đang trống.";
+    static final String ADDRESS_REQUIRED = "Vui lòng chọn địa chỉ đã lưu hoặc nhập đầy đủ tên người nhận, số điện thoại và địa chỉ giao hàng.";
+
+    @Autowired private CartRepository cartRepository;
+    @Autowired private CartItemRepository cartItemRepository;
+    @Autowired private OrderItemRepository orderItemRepository;
+    @Autowired private OrderService orderService;
+    @Autowired private PaymentService paymentService;
+    @Autowired private DiscountService discountService;
+    @Autowired private AddressService addressService;
+    // B03 batch availability. InventoryGateway has no availableFor, and the B03 interface is not changed here, so (like
+    // CartService) the batch read goes straight to InventoryService.
+    @Autowired private InventoryService inventoryService;
+    @Autowired private InventoryGateway inventoryGateway;
+    @Autowired private ApplicationEventPublisher eventPublisher;
+
+    @Value("${ecogreen.shipping.flat-fee:30000}")
+    private BigDecimal shippingFlatFee;
+    @Value("${ecogreen.shipping.free-threshold:500000}")
+    private BigDecimal shippingFreeThreshold;
+
+    /** What a cart costs: all amounts have scale 2, {@code total = subtotal - discountAmount + shippingFee}. */
+    public record Quote(BigDecimal subtotal, BigDecimal discountAmount, BigDecimal shippingFee, BigDecimal total,
+                        String discountCode) {}
+
+    /** The order that was placed with its items (products loaded), ready for {@code OrderResponse.from}. */
+    public record PlacedOrder(Order order, List<OrderItem> items) {}
+
+    @PostConstruct
+    void validateConfiguration() {
+        if (shippingFlatFee == null || shippingFlatFee.signum() < 0
+                || shippingFreeThreshold == null || shippingFreeThreshold.signum() < 0) {
+            throw new IllegalStateException("ecogreen.shipping.flat-fee and ecogreen.shipping.free-threshold must be >= 0.");
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Checkout
+    // ------------------------------------------------------------------------------------------------------------
+
+    @Transactional
+    public PlacedOrder checkout(Long userId, CheckoutRequest request) {
+        if (userId == null) throw new BadRequestException("Thiếu thông tin người đặt hàng.");
+        // Pure request checks first: nothing is read or locked for a malformed request.
+        String method = PaymentService.normalizeMethod(request.paymentMethod());
+
+        // (1) lock the cart row: a concurrent second checkout of this cart waits here, then finds it empty.
+        Cart cart = cartRepository.findByUserIdForUpdate(userId)
+                .orElseThrow(() -> new BusinessRuleViolationException(EMPTY_CART));
+
+        // (2) items WITH their products in ONE query.
+        List<CartItem> items = cartItemRepository.findByCartIdWithProduct(cart.getId());
+        if (items.isEmpty()) throw new BusinessRuleViolationException(EMPTY_CART);
+
+        // (3) per item: ACTIVE, quantity > 0, enough stock (one batched read). Prices come from the product rows just loaded.
+        Map<Long, Integer> available = inventoryService.availableFor(items.stream().map(i -> i.getProduct().getId()).toList());
+        for (CartItem item : items) {
+            Product product = item.getProduct();
+            if (item.getQuantity() <= 0) {
+                throw new BusinessRuleViolationException("Số lượng sản phẩm \"" + product.getName() + "\" không hợp lệ.");
+            }
+            LineIssue issue = LineIssue.check(product, item.getQuantity(), available.getOrDefault(product.getId(), 0));
+            if (issue != null) {
+                if (product.getStatus() != Product.Status.ACTIVE) throw new BusinessRuleViolationException(issue.message());
+                throw new InsufficientStockException(product.getId(), item.getQuantity(), product.getName());
+            }
+        }
+
+        // (4)-(7) subtotal, discount, shipping, total.
+        BigDecimal subtotal = subtotalOf(items);
+        Quote quote = price(subtotal, request.discountCode(), LocalDateTime.now());
+
+        // (8) the recipient snapshot (a foreign addressId is a 403 here, before anything is written), then the pending order.
+        Recipient recipient = recipientFor(userId, request);
+        List<OrderItemDraft> drafts = items.stream()
+                .map(i -> new OrderItemDraft(i.getProduct().getId(), i.getQuantity(), i.getProduct().getPrice()))
+                .sorted(Comparator.comparing(OrderItemDraft::productId))
+                .collect(Collectors.toCollection(ArrayList::new));
+        Order order = orderService.createPendingOrder(userId, drafts, quote.subtotal(), quote.discountAmount(),
+                quote.shippingFee(), quote.total(), recipient.name(), recipient.phone(), recipient.address(),
+                quote.discountCode());
+
+        // (9) reserve in ASCENDING product id (B03 lock-ordering rule); any InsufficientStockException rolls back everything.
+        for (OrderItemDraft draft : drafts) {
+            inventoryGateway.reserve(draft.productId(), draft.quantity(), INVENTORY_REF_TYPE, order.getId());
+        }
+
+        // (10) the first payment row.
+        paymentService.createPendingPayment(order, method);
+
+        // (11) the cart is cleared LAST: it is the final write of the transaction.
+        cartItemRepository.deleteAllByCartId(cart.getId());
+
+        // Read-only: the items for the response, then announce the order (consumers run AFTER_COMMIT).
+        List<OrderItem> placedItems = orderItemRepository.findByOrderIdWithProduct(order.getId());
+        eventPublisher.publishEvent(new OrderPlacedEvent(order.getId(), userId, order.getTotalPrice()));
+        return new PlacedOrder(order, placedItems);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Preview
+    // ------------------------------------------------------------------------------------------------------------
+
+    /**
+     * The same numbers checkout would charge, with no side effect: no lock, no reservation, no write. Problems are reported in
+     * {@code issues} instead of failing, so the page can show the breakdown and the reasons together.
+     */
+    @Transactional(readOnly = true)
+    public CheckoutPreviewResponse preview(Long userId, CheckoutRequest request) {
+        List<CartItem> items = cartRepository.findByUserId(userId)
+                .map(cart -> cartItemRepository.findByCartIdWithProduct(cart.getId()))
+                .orElse(List.of());
+        Map<Long, Integer> available = items.isEmpty() ? Map.of()
+                : inventoryService.availableFor(items.stream().map(i -> i.getProduct().getId()).toList());
+
+        CheckoutPreviewResponse response = new CheckoutPreviewResponse();
+        response.items = new ArrayList<>();
+        response.issues = new ArrayList<>();
+        if (items.isEmpty()) {
+            response.issues.add(new CheckoutPreviewResponse.Issue(null, "CART_EMPTY", EMPTY_CART));
+        }
+        for (CartItem item : items) {
+            Product product = item.getProduct();
+            int stock = available.getOrDefault(product.getId(), 0);
+            response.items.add(new CheckoutPreviewResponse.Line(product.getId(), product.getName(), product.getPrice(),
+                    item.getQuantity(), lineTotal(product, item.getQuantity()), stock));
+            LineIssue issue = LineIssue.check(product, item.getQuantity(), stock);
+            if (issue != null) response.issues.add(new CheckoutPreviewResponse.Issue(product.getId(), issue.code(), issue.message()));
+        }
+
+        BigDecimal subtotal = subtotalOf(items);
+        Quote quote;
+        try {
+            quote = price(subtotal, request == null ? null : request.discountCode(), LocalDateTime.now());
+        } catch (DiscountService.InvalidDiscountException e) {
+            response.issues.add(new CheckoutPreviewResponse.Issue(null, "DISCOUNT_INVALID", DiscountService.INVALID_MESSAGE));
+            quote = price(subtotal, null, LocalDateTime.now()); // show the numbers without the rejected code
+        }
+        response.subtotal = quote.subtotal();
+        response.discountAmount = quote.discountAmount();
+        response.shippingFee = quote.shippingFee();
+        response.total = quote.total();
+        response.discountCode = quote.discountCode();
+        return response;
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Pricing (shared by checkout and preview)
+    // ------------------------------------------------------------------------------------------------------------
+
+    /**
+     * Subtotal, discount (when a code is given), shipping and total. Throws {@link DiscountService.InvalidDiscountException}
+     * for a bad code. An empty cart (subtotal 0) pays no shipping: there is nothing to ship.
+     */
+    Quote price(BigDecimal subtotal, String discountCode, LocalDateTime now) {
+        BigDecimal discount = BigDecimal.ZERO.setScale(2);
+        String appliedCode = null;
+        if (discountCode != null && !discountCode.isBlank()) {
+            DiscountService.Applied applied = discountService.resolve(discountCode, subtotal, now);
+            discount = applied.amount();
+            appliedCode = applied.code();
+        }
+        BigDecimal goods = subtotal.subtract(discount);
+        BigDecimal shipping = subtotal.signum() == 0 ? BigDecimal.ZERO.setScale(2) : shippingFeeFor(goods);
+        BigDecimal total = subtotal.subtract(discount).add(shipping).setScale(2, RoundingMode.HALF_UP);
+        return new Quote(subtotal, discount, shipping, total, appliedCode);
+    }
+
+    /** The flat fee, or zero when {@code goods} (subtotal - discount) is AT LEAST the free threshold. Scale 2. */
+    BigDecimal shippingFeeFor(BigDecimal goods) {
+        if (goods.compareTo(shippingFreeThreshold) >= 0) return BigDecimal.ZERO.setScale(2);
+        return shippingFlatFee.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    /** Sum of price x quantity of the lines whose product can be sold (a withdrawn product is never charged). Scale 2. */
+    private static BigDecimal subtotalOf(List<CartItem> items) {
+        BigDecimal sum = BigDecimal.ZERO;
+        for (CartItem item : items) {
+            if (item.getProduct().getStatus() == Product.Status.ACTIVE) {
+                sum = sum.add(lineTotal(item.getProduct(), item.getQuantity()));
+            }
+        }
+        return sum.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private static BigDecimal lineTotal(Product product, int quantity) {
+        return product.getPrice().multiply(BigDecimal.valueOf(quantity)).setScale(2, RoundingMode.HALF_UP);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Address snapshot
+    // ------------------------------------------------------------------------------------------------------------
+
+    private record Recipient(String name, String phone, String address) {}
+
+    /**
+     * {@code addressId} wins when present: the address must belong to the caller (403 otherwise, 404 when unknown) and its fields
+     * are COPIED. Otherwise the three text fields are required. The order never references the address book.
+     */
+    private Recipient recipientFor(Long userId, CheckoutRequest request) {
+        if (request.addressId() != null) {
+            Address a = addressService.getOwned(userId, request.addressId());
+            String full = String.join(", ", a.getLine1(), a.getWard(), a.getDistrict(), a.getProvince());
+            return new Recipient(a.getRecipientName(), a.getPhone(), full);
+        }
+        if (isBlank(request.customerName()) || isBlank(request.customerPhone()) || isBlank(request.shippingAddress())) {
+            throw new BadRequestException(ADDRESS_REQUIRED);
+        }
+        return new Recipient(request.customerName().trim(), request.customerPhone().trim(), request.shippingAddress().trim());
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.isBlank();
+    }
+}

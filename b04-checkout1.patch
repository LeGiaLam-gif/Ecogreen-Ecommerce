+                item(13L, p3, 1),   // 0 available
+                item(14L, p4, 1))); // withdrawn
+        when(inventory.availableFor(anyCollection())).thenReturn(Map.of(1L, 5, 2L, 2, 3L, 0, 4L, 9));
+
+        CartResponse cartResponse = service.getCart(USER);

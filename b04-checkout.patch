+        String shippingAddress,
+        @Size(max = 30, message = "Mã giảm giá tối đa 30 ký tự.")
+        String discountCode,
+        @NotBlank(message = "Vui lòng chọn phương thức thanh toán.")
+        @Size(max = 20, message = "Phương thức thanh toán không hợp lệ.")
+        String paymentMethod) {
+}

+        assertThrows(IllegalArgumentException.class, () -> new ShippingPolicy(new BigDecimal("30000"), new BigDecimal("-1")));
+        assertThrows(IllegalArgumentException.class, () -> new ShippingPolicy(null, new BigDecimal("500000")));

+import React, { useEffect, useState } from 'react';
+import { useAuth } from '../../../context/AuthContext';
+import { listAdminReturns, updateReturnStatus } from '../../../services/returnApi';
+import { completeRefund } from '../../../services/paymentApi';
+import { PERM } from '../../../utils/permissions';
+import ImageGallery from '../ImageGallery';
+import { RETURN_STATUS_KEYS, returnStatusInfo, returnActionLabel, returnNeedsNote } from '../../../utils/returnStatus';
+
+const RETURN_PAGE_SIZE = 20;
+
+// Status of the refund (B06) linked to a return.
+const REFUND_LABELS = { PENDING: 'Chờ hoàn tiền', SUCCESS: 'Đã hoàn tiền', FAILED: 'Hoàn tiền thất bại' };
+
+/** "Đổi / Trả hàng" tab. `initialStatus` comes from the dashboard's pending-returns card. */
+const ReturnsTab = ({ initialStatus = 'ALL', onBadges }) => {
+  const { hasPermission } = useAuth();
+  const [errorMsg, setErrorMsg] = useState('');
+  const [returns, setReturns] = useState([]);
+  const [returnMeta, setReturnMeta] = useState({ page: 0, totalPages: 1, totalElements: 0 });
+  const [returnPage, setReturnPage] = useState(0);
+  const [returnStatusFilter, setReturnStatusFilter] = useState(initialStatus);
+  const [reloadKey, setReloadKey] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      setErrorMsg('');
+      try {
+        const [r, pending] = await Promise.all([
+          listAdminReturns({
+            page: returnPage,
+            size: RETURN_PAGE_SIZE,
+            status: returnStatusFilter === 'ALL' ? undefined : returnStatusFilter,
+          }),
+          listAdminReturns({ page: 0, size: 1, status: 'PENDING' }).catch(() => null),
+        ]);
+        if (cancelled) return;
+        setReturns(r.items);
+        setReturnMeta(r.meta);
+        if (onBadges) onBadges({ pendingReturns: pending?.meta?.totalElements ?? 0 });
+      } catch (error) {
+        if (!cancelled) setErrorMsg(error.friendlyMessage || 'Không thể tải dữ liệu.');
+      }
+    })();
+    return () => { cancelled = true; };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [returnPage, returnStatusFilter, reloadKey]);
+
+  // The buttons come from the server's `allowedNextStatuses`; the server re-checks the transition and the permission.
+  const handleUpdateReturnStatus = async (ret, newStatus) => {
+    let adminNote = null;
+    if (returnNeedsNote(newStatus)) {
+      const input = prompt(
+        newStatus === 'REJECTED'
+          ? 'Nhập lý do từ chối (bắt buộc, khách hàng sẽ thấy):'
+          : 'Nhập thông tin cần khách bổ sung (bắt buộc, khách hàng sẽ thấy):',
+        newStatus === 'REJECTED' ? 'Yêu cầu không đáp ứng điều kiện đổi trả trong 7 ngày.' : ''
+      );
+      if (input === null) return;
+      if (input.trim() === '') {
+        alert('Vui lòng nhập ghi chú phản hồi khách hàng.');
+        return;
+      }
+      adminNote = input.trim();
+    } else if (!window.confirm(`Xác nhận chuyển yêu cầu #${ret.id} sang "${returnStatusInfo(newStatus).label}"?`)) {
+      return;
+    }
+    try {
+      await updateReturnStatus(ret.id, newStatus, adminNote);
+      setReloadKey((n) => n + 1);
+    } catch (e) {
+      alert(e.friendlyMessage || 'Không thể cập nhật trạng thái đổi/trả.');
+    }
+  };
+
+  // B06: staff confirm that the pending refund of this return's order was sent (payment:refund). Money never moves from here.
+  const handleCompleteRefund = async (ret) => {
+    const reference = prompt(`Mã giao dịch hoàn tiền cho đơn hàng #${ret.orderId} (có thể để trống):`, '');
+    if (reference === null) return;
+    try {
+      await completeRefund(ret.orderId, reference.trim());
+      setReloadKey((n) => n + 1);
+    } catch (e) {
+      alert(e.friendlyMessage || 'Không thể hoàn tất hoàn tiền.');
+    }
+  };
+
+  return (
+    <>
+      {errorMsg && <p className="admin-error-text">{errorMsg}</p>}
+      <div className="admin-panel">
+        {/* Lọc trạng thái đổi trả (lọc bởi máy chủ) */}
+        <div className="admin-order-status-tabs">
+          {['ALL', ...RETURN_STATUS_KEYS].map((key) => (
+            <button
+              key={key}
+              type="button"
+              onClick={() => { setReturnPage(0); setReturnStatusFilter(key); }}
+              className={`admin-status-pill ${returnStatusFilter === key ? 'active' : ''}`}
+            >
+              {key === 'ALL' ? 'Tất cả yêu cầu' : returnStatusInfo(key).label}
+            </button>
+          ))}
+        </div>
+
+        <div className="admin-table-wrap">
+          <table className="admin-table">
+            <thead>
+              <tr>
+                <th>Mã YC</th>
+                <th>Mã Đơn</th>
+                <th>Khách hàng</th>
+                <th>Lý do &amp; mô tả</th>
+                <th>Sản phẩm trả</th>
+                <th>Ảnh</th>
+                <th>Trạng thái</th>
+                <th>Ghi chú phản hồi</th>
+                <th style={{ textAlign: 'center' }}>Thao tác</th>
+              </tr>
+            </thead>
+            <tbody>
+              {returns.map((r) => {
+                const info = returnStatusInfo(r.status);
+                const next = hasPermission(PERM.RETURN_PROCESS) ? (r.allowedNextStatuses || []) : []; // UX only
+                return (
+                  <tr key={r.id}>
+                    <td className="admin-cell-strong">#{r.id}</td>
+                    <td className="admin-cell-strong">#{r.orderId}</td>
+                    <td>{r.username}</td>
+                    <td style={{ maxWidth: '240px', fontSize: '0.88rem', color: '#4b5563' }}>
+                      <div style={{ color: '#e65100', fontWeight: 600 }}>{r.reason}</div>
+                      {r.description || '—'}
+                    </td>
+                    <td style={{ fontSize: '0.85rem' }}>
+                      {(r.items || []).length === 0
+                        ? <span className="admin-cell-muted">Toàn bộ đơn (yêu cầu cũ)</span>
+                        : r.items.map((it) => (
+                          <div key={it.orderItemId}>{it.productName} × {it.quantity}</div>
+                        ))}
+                    </td>
+                    <td>
+                      <ImageGallery urls={r.images || []} />
+                    </td>
+                    <td>
+                      <span style={{
+                        display: 'inline-block',
+                        padding: '4px 10px',
+                        borderRadius: '12px',
+                        fontSize: '0.78rem',
+                        fontWeight: 'bold',
+                        backgroundColor: info.bg,
+                        color: info.color,
+                      }}>
+                        {info.label}
+                      </span>
+                      {r.refund && (
+                        <div style={{ fontSize: '0.78rem', color: '#555', marginTop: '4px' }}>
+                          Hoàn tiền: {Number(r.refund.amount).toLocaleString('vi-VN')} ₫ — {REFUND_LABELS[r.refund.status] || r.refund.status}
+                        </div>
+                      )}
+                      {r.refundMessage && (
+                        <div style={{ fontSize: '0.78rem', color: '#555', marginTop: '4px' }}>{r.refundMessage}</div>
+                      )}
+                    </td>
+                    <td style={{ fontSize: '0.88rem', color: '#555' }}>{r.adminNote || '—'}</td>
+                    <td style={{ textAlign: 'center' }}>
+                      {next.length > 0 ? (
+                        <div style={{ display: 'flex', gap: '8px', justifyContent: 'center', flexWrap: 'wrap' }}>
+                          {next.map((st) => (
+                            <button
+                              key={st}
+                              onClick={() => handleUpdateReturnStatus(r, st)}
+                              className={st === 'REJECTED' ? 'admin-btn-reject' : 'admin-btn-approve'}
+                            >
+                              {returnActionLabel(st)}
+                            </button>
+                          ))}
+                        </div>
+                      ) : (
+                        <span style={{ color: '#9ca3af', fontSize: '0.85rem' }}>
+                          {r.status === 'REFUNDED' ? 'Đã hoàn tất' : '—'}
+                        </span>
+                      )}
+                      {r.refund && r.refund.status === 'PENDING' && hasPermission(PERM.PAYMENT_REFUND) && (
+                        <div style={{ marginTop: '6px' }}>
+                          <button type="button" onClick={() => handleCompleteRefund(r)} className="admin-btn-approve">
+                            Hoàn tất hoàn tiền
+                          </button>
+                          <div style={{ fontSize: '0.75rem', color: '#555', marginTop: '4px' }}>
+                            Bấm sau khi đã chuyển tiền cho khách.
+                          </div>
+                        </div>
+                      )}
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+          {returns.length === 0 && (
+            <div className="admin-empty">Không có yêu cầu đổi/trả nào phù hợp.</div>
+          )}
+          {returnMeta.totalPages > 1 && (
+            <div className="admin-pagination">
+              <button type="button" disabled={returnPage === 0} onClick={() => setReturnPage((x) => x - 1)}>← Trước</button>
+              <span>Trang {returnPage + 1} / {returnMeta.totalPages} ({returnMeta.totalElements} yêu cầu)</span>
+              <button type="button" disabled={returnPage + 1 >= returnMeta.totalPages} onClick={() => setReturnPage((x) => x + 1)}>Sau →</button>
+            </div>
+          )}
+        </div>
+      </div>
+    </>
+  );
+};
+
+export default ReturnsTab;
diff --git a/frontend/src/pages/admin/tabs/UserDetailModal.jsx b/frontend/src/pages/admin/tabs/UserDetailModal.jsx
new file mode 100644
index 0000000..02da9f5
--- /dev/null
+++ b/frontend/src/pages/admin/tabs/UserDetailModal.jsx
@@ -0,0 +1,110 @@
+import React, { useEffect, useState } from 'react';
+import { getAdminUser, getAdminUserOrders } from '../../../services/userApi';
+import { orderStatusInfo } from '../../../utils/orderStatus';
+import AdminPagination from '../AdminPagination';
+
+const ORDER_PAGE_SIZE = 10;
+const formatDate = (v) => (v ? new Date(v).toLocaleString('vi-VN') : '—');
+
+/**
+ * Customer detail (B08): account data, the two counters and the order history, paged by the server. Needs user:view.
+ * `onToggle` (lock / unlock) is passed only to users who hold user:disable and only for accounts other than their own.
+ */
+const UserDetailModal = ({ userId, onClose, onToggle }) => {
+  const [user, setUser] = useState(null);
+  const [orders, setOrders] = useState(null);
+  const [orderPage, setOrderPage] = useState(0);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    let cancelled = false;
+    getAdminUser(userId)
+      .then((u) => { if (!cancelled) { setUser(u); setError(''); } })
+      .catch((e) => { if (!cancelled) setError(e.friendlyMessage || 'Không thể tải thông tin người dùng.'); });
+    return () => { cancelled = true; };
+  }, [userId]);
+
+  useEffect(() => {
+    let cancelled = false;
+    getAdminUserOrders(userId, { page: orderPage, size: ORDER_PAGE_SIZE })
+      .then((o) => { if (!cancelled) setOrders(o); })
+      .catch((e) => { if (!cancelled) setError(e.friendlyMessage || 'Không thể tải lịch sử đơn hàng.'); });
+    return () => { cancelled = true; };
+  }, [userId, orderPage]);
+
+  return (
+    <div className="admin-modal-overlay">
+      <div className="admin-modal-card" style={{ maxWidth: '820px' }}>
+        <h3 style={{ color: '#1b3a1f', marginTop: 0 }}>👤 Chi tiết tài khoản #{userId}</h3>
+        {error && <p className="admin-error-text">{error}</p>}
+        {!user && !error && <div className="admin-empty">Đang tải...</div>}
+        {user && (
+          <>
+            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '6px 20px', marginBottom: '14px' }}>
+              <div><span className="admin-cell-muted">Tên đăng nhập: </span><strong>{user.username}</strong></div>
+              <div><span className="admin-cell-muted">Email: </span>{user.email}</div>
+              <div><span className="admin-cell-muted">Vai trò: </span>{(user.roles || []).join(', ') || '—'}</div>
+              <div>
+                <span className="admin-cell-muted">Trạng thái: </span>
+                <strong style={{ color: user.active ? '#2e7d32' : '#9ca3af' }}>{user.active ? 'Hoạt động' : 'Đã khóa'}</strong>
+              </div>
+              <div><span className="admin-cell-muted">Ngày tạo: </span>{formatDate(user.createdAt)}</div>
+              <div>
+                <span className="admin-cell-muted">Số đơn / yêu cầu đổi trả: </span>
+                <strong>{user.orderCount ?? 0}</strong> / <strong>{user.returnRequestCount ?? 0}</strong>
+              </div>
+            </div>
+            {onToggle && (
+              <div style={{ marginBottom: '14px' }}>
+                <button type="button" onClick={() => onToggle(user)} className="admin-btn-action-edit">
+                  {user.active ? 'Khóa tài khoản' : 'Mở khóa tài khoản'}
+                </button>
+              </div>
+            )}
+          </>
+        )}
+
+        <h4 style={{ margin: '8px 0' }}>Lịch sử đơn hàng</h4>
+        {orders && (
+          <div className="admin-table-wrap">
+            <table className="admin-table">
+              <thead>
+                <tr>
+                  <th>Mã ĐH</th>
+                  <th>Ngày đặt</th>
+                  <th>Tổng tiền</th>
+                  <th>Trạng thái</th>
+                </tr>
+              </thead>
+              <tbody>
+                {orders.items.map((o) => {
+                  const info = orderStatusInfo(o.status);
+                  return (
+                    <tr key={o.id}>
+                      <td className="admin-cell-strong">#{o.id}</td>
+                      <td className="admin-cell-muted">{formatDate(o.createdAt)}</td>
+                      <td className="admin-cell-price">{Number(o.totalPrice).toLocaleString('vi-VN')} ₫</td>
+                      <td>
+                        <span style={{ padding: '4px 10px', borderRadius: '12px', fontSize: '0.8rem', fontWeight: 600, backgroundColor: info.bg, color: info.color }}>
+                          {info.label}
+                        </span>
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+            {orders.items.length === 0 && <div className="admin-empty">Người dùng này chưa có đơn hàng nào.</div>}
+            <AdminPagination meta={orders.meta} page={orderPage} onPage={setOrderPage} noun="đơn" />
+          </div>
+        )}
+
+        <div style={{ display: 'flex', justifyContent: 'flex-end', marginTop: '12px' }}>
+          <button type="button" onClick={onClose} className="admin-btn-secondary">Đóng</button>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default UserDetailModal;
diff --git a/frontend/src/pages/admin/tabs/UsersTab.jsx b/frontend/src/pages/admin/tabs/UsersTab.jsx
new file mode 100644
index 0000000..667d5af
--- /dev/null
+++ b/frontend/src/pages/admin/tabs/UsersTab.jsx
@@ -0,0 +1,209 @@
+import React, { useEffect, useState } from 'react';
+import { useAuth } from '../../../context/AuthContext';
+import { usePermissions } from '../../../hooks/usePermission';
+import { PERM } from '../../../utils/permissions';
+import UserDetailModal from './UserDetailModal';
+import { listAdminUsers, disableUser, enableUser, deleteUser } from '../../../services/userApi';
+
+const USER_PAGE_SIZE = 20;
+
+/** "Khách hàng" tab (B08). `initialUserId` opens that account's detail straight away (from the dashboard). */
+const UsersTab = ({ initialUserId = null }) => {
+  const { user } = useAuth();
+  const { can } = usePermissions();
+  const canDisable = can(PERM.USER_DISABLE); // lock / unlock and delete are both user:disable on the server
+  const [detailId, setDetailId] = useState(initialUserId);
+  const [errorMsg, setErrorMsg] = useState('');
+  const [users, setUsers] = useState([]);
+  const [userMeta, setUserMeta] = useState({ page: 0, totalPages: 1, totalElements: 0 });
+  const [userPage, setUserPage] = useState(0);
+  const [usersLoading, setUsersLoading] = useState(false);
+  const [userReload, setUserReload] = useState(0);
+  const [searchTerm, setSearchTerm] = useState('');
+  const [userRoleFilter, setUserRoleFilter] = useState('ALL');
+  const [userActiveFilter, setUserActiveFilter] = useState('ALL');
+
+  // Search / role / active filters and paging are applied by the server; a new request cancels the previous one.
+  useEffect(() => {
+    const controller = new AbortController();
+    const timer = setTimeout(async () => {
+      setUsersLoading(true);
+      try {
+        const result = await listAdminUsers({
+          keyword: searchTerm.trim() || undefined,
+          role: userRoleFilter === 'ALL' ? undefined : userRoleFilter,
+          active: userActiveFilter === 'ALL' ? undefined : userActiveFilter,
+          page: userPage,
+          size: USER_PAGE_SIZE,
+        }, { signal: controller.signal });
+        if (controller.signal.aborted) return;
+        setUsers(result.items || []);
+        setUserMeta(result.meta || { page: 0, totalPages: 1, totalElements: 0 });
+      } catch (err) {
+        if (!controller.signal.aborted) setErrorMsg(err.friendlyMessage || 'Không thể tải danh sách người dùng.');
+      } finally {
+        if (!controller.signal.aborted) setUsersLoading(false);
+      }
+    }, 300);
+    return () => {
+      clearTimeout(timer);
+      controller.abort();
+    };
+  }, [searchTerm, userRoleFilter, userActiveFilter, userPage, userReload]);
+
+  const reloadUsers = () => setUserReload((n) => n + 1);
+
+  const handleToggleUser = async (u) => {
+    const disabling = u.active;
+    const question = disabling
+      ? `Khóa tài khoản "${u.username}"? Người dùng sẽ bị đăng xuất khỏi mọi thiết bị.`
+      : `Mở khóa tài khoản "${u.username}"?`;
+    if (!window.confirm(question)) return;
+    try {
+      if (disabling) await disableUser(u.id);
+      else await enableUser(u.id);
+      reloadUsers();
+    } catch (e) {
+      alert(e.friendlyMessage || 'Thao tác thất bại.');
+    }
+  };
+
+  // The server refuses (409) for a user with orders / return requests, for yourself and for the last active admin;
+  // its message ("hãy khóa tài khoản") is shown as is.
+  const handleDeleteUser = async (id, name) => {
+    if (!window.confirm(`Bạn có chắc chắn muốn xóa tài khoản "${name}"?`)) return;
+    try {
+      await deleteUser(id);
+      reloadUsers();
+    } catch (e) {
+      alert(e.friendlyMessage || 'Thao tác thất bại.');
+    }
+  };
+
+  return (
+    <>
+      {errorMsg && <p className="admin-error-text">{errorMsg}</p>}
+      <div className="admin-panel">
+        <div className="admin-panel-toolbar">
+          <div style={{ display: 'flex', gap: '10px', flexWrap: 'wrap' }}>
+            <input
+              type="text"
+              placeholder="Tìm theo tên đăng nhập hoặc email..."
+              value={searchTerm}
+              onChange={(e) => { setUserPage(0); setSearchTerm(e.target.value); }}
+              className="admin-search-input"
+            />
+            <select
+              value={userRoleFilter}
+              onChange={(e) => { setUserPage(0); setUserRoleFilter(e.target.value); }}
+              className="admin-filter-select"
+            >
+              <option value="ALL">Tất cả vai trò</option>
+              <option value="ADMIN">Quản trị viên (ADMIN)</option>
+              <option value="MANAGER">Quản lý (MANAGER)</option>
+              <option value="CUSTOMER">Khách hàng (CUSTOMER)</option>
+            </select>
+            <select
+              value={userActiveFilter}
+              onChange={(e) => { setUserPage(0); setUserActiveFilter(e.target.value); }}
+              className="admin-filter-select"
+            >
+              <option value="ALL">Mọi trạng thái</option>
+              <option value="true">Đang hoạt động</option>
+              <option value="false">Đã khóa</option>
+            </select>
+          </div>
+        </div>
+
+        <div className="admin-table-wrap">
+          <table className="admin-table">
+            <thead>
+              <tr>
+                <th>Mã ND</th>
+                <th>Tên tài khoản</th>
+                <th>Email</th>
+                <th>Vai trò phân quyền</th>
+                <th>Trạng thái</th>
+                <th style={{ textAlign: 'center' }}>Thao tác</th>
+              </tr>
+            </thead>
+            <tbody>
+              {users.map((u) => (
+                <tr key={u.id} style={u.active ? undefined : { opacity: 0.6 }}>
+                  <td className="admin-cell-strong">#{u.id}</td>
+                  <td className="admin-cell-strong">{u.username}</td>
+                  <td>{u.email}</td>
+                  <td>
+                    {u.roles.map((r) => (
+                      <span
+                        key={r}
+                        style={{
+                          padding: '4px 8px',
+                          borderRadius: '4px',
+                          fontSize: '0.8rem',
+                          backgroundColor: r === 'ADMIN' ? '#c62828' : (r === 'MANAGER' ? '#ef6c00' : '#1976d2'),
+                          color: '#fff',
+                          marginRight: '4px',
+                          fontWeight: 600,
+                        }}
+                      >
+                        {r === 'ADMIN' ? 'Quản trị viên' : (r === 'MANAGER' ? 'Quản lý' : 'Khách hàng')}
+                      </span>
+                    ))}
+                  </td>
+                  <td>
+                    <span style={{ color: u.active ? '#2e7d32' : '#9ca3af', fontWeight: 600 }}>
+                      {u.active ? 'Hoạt động' : 'Đã khóa'}
+                    </span>
+                  </td>
+                  <td style={{ textAlign: 'center' }}>
+                    <button onClick={() => setDetailId(u.id)} className="admin-btn-action-edit">Chi tiết</button>
+                    {u.id === user?.id ? (
+                      <span style={{ color: '#9ca3af', fontSize: '0.85rem' }}>Bạn</span>
+                    ) : canDisable && (
+                      <>
+                        <button
+                          onClick={() => handleToggleUser(u)}
+                          className="admin-btn-action-edit"
+                        >
+                          {u.active ? 'Khóa' : 'Mở khóa'}
+                        </button>
+                        <button
+                          onClick={() => handleDeleteUser(u.id, u.username)}
+                          className="admin-btn-action-delete"
+                        >
+                          Xóa
+                        </button>
+                      </>
+                    )}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+          {!usersLoading && users.length === 0 && (
+            <div className="admin-empty">Không tìm thấy người dùng nào phù hợp.</div>
+          )}
+          {userMeta.totalPages > 1 && (
+            <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', gap: '14px', padding: '14px' }}>
+              <button type="button" disabled={userPage === 0} onClick={() => setUserPage((x) => x - 1)}>← Trước</button>
+              <span>Trang {userPage + 1} / {userMeta.totalPages} ({userMeta.totalElements} người dùng)</span>
+              <button type="button" disabled={userPage + 1 >= userMeta.totalPages} onClick={() => setUserPage((x) => x + 1)}>Sau →</button>
+            </div>
+          )}
+        </div>
+      </div>
+      {detailId !== null && (
+        <UserDetailModal
+          userId={detailId}
+          onClose={() => setDetailId(null)}
+          onToggle={canDisable && detailId !== user?.id
+            ? async (u) => { await handleToggleUser(u); setDetailId(null); }
+            : null}
+        />
+      )}
+    </>
+  );
+};
+
+export default UsersTab;
